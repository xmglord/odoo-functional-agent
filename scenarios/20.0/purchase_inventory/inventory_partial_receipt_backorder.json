{
  "format": "ofa.scenario/1",
  "id": "inventory_partial_receipt_backorder",
  "area": "purchase_inventory",
  "odoo_version": "20.0",
  "edition": "community",
  "description": "A purchase order for 10 units of a storable product is confirmed; only 6 arrive. The receipt move's done quantity is set to 6 and the receipt is validated: Odoo returns the stock.backorder.confirmation wizard without res_id, which ofa creates from the action context and answers with process. Proves the receipt is done with 6 and that one backorder picking keeps the 4 units still to receive (the live check of the backorder wizard path).",
  "requires": {"modules": ["purchase_stock"]},
  "preconditions": [
    {"id": "p010", "action": "assert", "model": "stock.picking.type", "target": {"$ref": "stock.picking_type_in"},
     "expect": {"fields": {"create_backorder": {"eq": "ask"}}}}
  ],
  "steps": [
    {"id": "s010", "action": "create", "model": "product.product",
     "values": {"name": "OFA scenario pallet (partial receipt)", "type": "consu", "is_storable": true,
                "purchase_method": "receive", "purchase_ok": true},
     "save_as": "product"},
    {"id": "s020", "action": "create", "model": "purchase.order",
     "values": {"partner_id": {"$ref": "base.res_partner_12"},
                "order_line": {"$create": [{"product_id": {"$var": "product"}, "product_qty": 10, "price_unit": 2.5}]}},
     "save_as": "po"},
    {"id": "s030", "action": "call", "model": "purchase.order", "target": {"$var": "po"}, "method": "button_confirm"},
    {"id": "s040", "action": "search", "model": "stock.picking",
     "domain": [["purchase_id", "=", {"$var": "po"}]], "save_as": "receipts",
     "expect": {"count": 1}},
    {"id": "s050", "action": "assert", "model": "stock.picking", "target": {"$var": "receipts"},
     "expect": {"fields": {"picking_type_id": {"eq": {"$ref": "stock.picking_type_in"}}, "state": {"eq": "assigned"}}}},
    {"id": "s060", "action": "search", "model": "stock.move",
     "domain": [["picking_id", "in", {"$var": "receipts"}]], "save_as": "receipt_moves",
     "expect": {"count": 1}},
    {"id": "s070", "action": "assert", "model": "stock.move", "target": {"$var": "receipt_moves"},
     "expect": {"fields": {"product_uom_qty": {"eq": 10}}}},
    {"id": "s080", "action": "write", "model": "stock.move", "target": {"$var": "receipt_moves"},
     "values": {"quantity": 6}},
    {"id": "s090", "action": "assert", "model": "stock.move", "target": {"$var": "receipt_moves"},
     "expect": {"fields": {"quantity": {"eq": 6}, "product_uom_qty": {"eq": 10}}}},
    {"id": "s100", "action": "call", "model": "stock.picking", "target": {"$var": "receipts"}, "method": "button_validate",
     "wizards": {"stock.backorder.confirmation": "process"}},
    {"id": "s110", "action": "assert", "model": "stock.picking", "target": {"$var": "receipts"},
     "expect": {"fields": {"state": {"eq": "done"}}}},
    {"id": "s120", "action": "search", "model": "stock.picking",
     "domain": [["backorder_id", "in", {"$var": "receipts"}]], "save_as": "backorders",
     "expect": {"count": 1}},
    {"id": "s130", "action": "assert", "model": "stock.picking", "target": {"$var": "backorders"},
     "expect": {"fields": {"state": {"eq": "assigned"}, "purchase_id": {"eq": {"$var": "po"}}}}},
    {"id": "s140", "action": "assert", "model": "stock.move",
     "target": {"$search": {"model": "stock.move", "domain": [["picking_id", "in", {"$var": "backorders"}]]}},
     "expect": {"fields": {"product_uom_qty": {"eq": 4}, "product_id": {"eq": {"$var": "product"}}}}},
    {"id": "s150", "action": "assert", "model": "stock.move", "target": {"$var": "receipt_moves"},
     "expect": {"fields": {"state": {"eq": "done"}, "quantity": {"eq": 6}}}},
    {"id": "s160", "action": "assert", "model": "purchase.order.line",
     "target": {"$search": {"model": "purchase.order.line", "domain": [["order_id", "=", {"$var": "po"}]]}},
     "expect": {"fields": {"qty_received": {"eq": 6}, "qty_to_invoice": {"eq": 6}}}},
    {"id": "s170", "action": "assert", "model": "purchase.order", "target": {"$var": "po"},
     "expect": {"fields": {"receipt_status": {"eq": "partial"}}}}
  ],
  "evidence": [
    {"label": "done_receipt", "model": "stock.picking", "target": {"$var": "receipts"},
     "fields": ["name", "state", "origin"], "screenshot": true},
    {"label": "backorder", "model": "stock.picking", "target": {"$var": "backorders"},
     "fields": ["name", "state", "backorder_id", "origin"], "screenshot": true},
    {"label": "po_partially_received", "model": "purchase.order", "target": {"$var": "po"},
     "fields": ["name", "state", "receipt_status", "invoice_status"], "screenshot": false}
  ]
}
