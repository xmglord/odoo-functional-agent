{
  "format": "ofa.scenario/1",
  "id": "purchase_po_to_bill",
  "area": "purchase_inventory",
  "odoo_version": "20.0",
  "edition": "community",
  "description": "A purchase order for a received-quantities product is confirmed, nothing is billable until the receipt is validated, then the vendor bill is created from the order, dated and posted. Proves the PO -> receipt -> bill chain and that bill control follows received quantities. With the setup's two-step receipts, the receipt goes to WH/Input; the storage step is covered by inventory_two_step_receipt.",
  "requires": {"modules": ["purchase", "purchase_stock", "account"]},
  "preconditions": [
    {"id": "p010", "action": "search", "model": "res.partner",
     "domain": [["id", "=", {"$ref": "base.res_partner_12"}]],
     "expect": {"count": 1}}
  ],
  "steps": [
    {"id": "s010", "action": "create", "model": "product.product",
     "values": {"name": "OFA scenario bolt (received qty)", "type": "consu", "is_storable": true,
                "purchase_method": "receive", "purchase_ok": true, "standard_price": 2.0},
     "save_as": "product"},
    {"id": "s020", "action": "assert", "model": "product.product", "target": {"$var": "product"},
     "expect": {"fields": {"purchase_method": {"eq": "receive"}, "is_storable": {"eq": true}}}},
    {"id": "s030", "action": "create", "model": "purchase.order",
     "values": {"partner_id": {"$ref": "base.res_partner_12"},
                "order_line": {"$create": [{"product_id": {"$var": "product"}, "product_qty": 5, "price_unit": 3.0}]}},
     "save_as": "po"},
    {"id": "s040", "action": "call", "model": "purchase.order", "target": {"$var": "po"}, "method": "button_confirm"},
    {"id": "s050", "action": "assert", "model": "purchase.order", "target": {"$var": "po"},
     "expect": {"fields": {"state": {"eq": "purchase"}, "invoice_status": {"eq": "no"}, "receipt_status": {"eq": "pending"}}}},
    {"id": "s060", "action": "assert", "model": "purchase.order.line",
     "target": {"$search": {"model": "purchase.order.line", "domain": [["order_id", "=", {"$var": "po"}]]}},
     "expect": {"fields": {"qty_received": {"eq": 0}, "qty_to_invoice": {"eq": 0}}}},
    {"id": "s070", "action": "search", "model": "stock.picking",
     "domain": [["purchase_id", "=", {"$var": "po"}]], "save_as": "receipts",
     "expect": {"count": 1}},
    {"id": "s080", "action": "call", "model": "stock.picking", "target": {"$var": "receipts"}, "method": "button_validate"},
    {"id": "s090", "action": "assert", "model": "stock.picking", "target": {"$var": "receipts"},
     "expect": {"fields": {"state": {"eq": "done"}}}},
    {"id": "s100", "action": "assert", "model": "purchase.order.line",
     "target": {"$search": {"model": "purchase.order.line", "domain": [["order_id", "=", {"$var": "po"}]]}},
     "expect": {"fields": {"qty_received": {"eq": 5}, "qty_to_invoice": {"eq": 5}, "qty_invoiced": {"eq": 0}}}},
    {"id": "s110", "action": "assert", "model": "purchase.order", "target": {"$var": "po"},
     "expect": {"fields": {"invoice_status": {"eq": "to invoice"}, "receipt_status": {"eq": "full"}}}},
    {"id": "s120", "action": "call", "model": "purchase.order", "target": {"$var": "po"}, "method": "action_create_invoice"},
    {"id": "s130", "action": "search", "model": "account.move",
     "domain": [["invoice_line_ids.purchase_line_id.order_id", "=", {"$var": "po"}], ["move_type", "=", "in_invoice"]],
     "save_as": "bills",
     "expect": {"count": 1}},
    {"id": "s140", "action": "write", "model": "account.move", "target": {"$var": "bills"},
     "values": {"invoice_date": "2026-10-26"}},
    {"id": "s150", "action": "call", "model": "account.move", "target": {"$var": "bills"}, "method": "action_post"},
    {"id": "s160", "action": "assert", "model": "account.move", "target": {"$var": "bills"},
     "expect": {"fields": {"state": {"eq": "posted"}, "move_type": {"eq": "in_invoice"},
                           "partner_id": {"eq": {"$ref": "base.res_partner_12"}}, "amount_untaxed": {"eq": 15.0}}}},
    {"id": "s170", "action": "assert", "model": "purchase.order.line",
     "target": {"$search": {"model": "purchase.order.line", "domain": [["order_id", "=", {"$var": "po"}]]}},
     "expect": {"fields": {"qty_invoiced": {"eq": 5}, "qty_to_invoice": {"eq": 0}}}},
    {"id": "s180", "action": "assert", "model": "purchase.order", "target": {"$var": "po"},
     "expect": {"fields": {"invoice_status": {"eq": "invoiced"}, "invoice_count": {"eq": 1}}}}
  ],
  "evidence": [
    {"label": "confirmed_po", "model": "purchase.order", "target": {"$var": "po"},
     "fields": ["name", "state", "receipt_status", "invoice_status", "amount_total"], "screenshot": true},
    {"label": "validated_receipt", "model": "stock.picking", "target": {"$var": "receipts"},
     "fields": ["name", "state", "origin", "location_dest_id"], "screenshot": false},
    {"label": "posted_bill", "model": "account.move", "target": {"$var": "bills"},
     "fields": ["name", "state", "invoice_date", "amount_untaxed", "amount_total", "invoice_origin"], "screenshot": true}
  ]
}
