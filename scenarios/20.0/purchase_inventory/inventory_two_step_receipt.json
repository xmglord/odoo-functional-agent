{
  "format": "ofa.scenario/1",
  "id": "inventory_two_step_receipt",
  "area": "purchase_inventory",
  "odoo_version": "20.0",
  "edition": "community",
  "description": "With the main warehouse in two-step receipts, a confirmed purchase order creates a receipt into WH/Input; validating it creates the storage transfer from WH/Input to WH/Stock (a push rule, not linked to the order), and only after that transfer is validated is the quantity in WH/Stock. Proves the two-step receipt route works end to end.",
  "requires": {"modules": ["purchase_stock"]},
  "preconditions": [
    {"id": "p010", "action": "assert", "model": "stock.warehouse", "target": {"$ref": "stock.warehouse0"},
     "expect": {"fields": {"reception_steps": {"eq": "two_steps"}}}},
    {"id": "p020", "action": "search", "model": "stock.location",
     "domain": [["complete_name", "=", "WH/Input"]], "expect": {"count": 1}}
  ],
  "steps": [
    {"id": "s010", "action": "create", "model": "product.product",
     "values": {"name": "OFA scenario crate (two-step)", "type": "consu", "is_storable": true, "purchase_ok": true},
     "save_as": "product"},
    {"id": "s020", "action": "create", "model": "purchase.order",
     "values": {"partner_id": {"$ref": "base.res_partner_12"},
                "order_line": {"$create": [{"product_id": {"$var": "product"}, "product_qty": 8, "price_unit": 4.0}]}},
     "save_as": "po"},
    {"id": "s030", "action": "call", "model": "purchase.order", "target": {"$var": "po"}, "method": "button_confirm"},
    {"id": "s040", "action": "search", "model": "stock.picking",
     "domain": [["purchase_id", "=", {"$var": "po"}]], "save_as": "receipts",
     "expect": {"count": 1}},
    {"id": "s050", "action": "assert", "model": "stock.picking", "target": {"$var": "receipts"},
     "expect": {"fields": {"picking_type_id": {"eq": {"$ref": "stock.picking_type_in"}},
                           "location_dest_id": {"eq": {"$search": {"model": "stock.location", "domain": [["complete_name", "=", "WH/Input"]]}}},
                           "state": {"eq": "assigned"}}}},
    {"id": "s060", "action": "search", "model": "stock.picking",
     "domain": [["move_ids.move_orig_ids.picking_id", "in", {"$var": "receipts"}]],
     "expect": {"count": 0}},
    {"id": "s070", "action": "call", "model": "stock.picking", "target": {"$var": "receipts"}, "method": "button_validate"},
    {"id": "s080", "action": "assert", "model": "stock.picking", "target": {"$var": "receipts"},
     "expect": {"fields": {"state": {"eq": "done"}}}},
    {"id": "s090", "action": "search", "model": "stock.picking",
     "domain": [["move_ids.move_orig_ids.picking_id", "in", {"$var": "receipts"}]], "save_as": "storage",
     "expect": {"count": 1}},
    {"id": "s100", "action": "assert", "model": "stock.picking", "target": {"$var": "storage"},
     "expect": {"fields": {"picking_type_id": {"eq": {"$search": {"model": "stock.picking.type", "domain": [["warehouse_id", "=", {"$ref": "stock.warehouse0"}], ["code", "=", "internal"], ["default_location_src_id.complete_name", "=", "WH/Input"], ["default_location_dest_id", "=", {"$ref": "stock.stock_location_stock"}]]}}},
                           "location_id": {"eq": {"$search": {"model": "stock.location", "domain": [["complete_name", "=", "WH/Input"]]}}},
                           "location_dest_id": {"eq": {"$ref": "stock.stock_location_stock"}},
                           "purchase_id": {"eq": false}}}},
    {"id": "s110", "action": "search", "model": "stock.quant",
     "domain": [["product_id", "=", {"$var": "product"}], ["location_id", "=", {"$ref": "stock.stock_location_stock"}]],
     "expect": {"count": 0}},
    {"id": "s120", "action": "assert", "model": "purchase.order.line",
     "target": {"$search": {"model": "purchase.order.line", "domain": [["order_id", "=", {"$var": "po"}]]}},
     "expect": {"fields": {"qty_received": {"eq": 8}}}},
    {"id": "s130", "action": "call", "model": "stock.picking", "target": {"$var": "storage"}, "method": "button_validate"},
    {"id": "s140", "action": "assert", "model": "stock.picking", "target": {"$var": "storage"},
     "expect": {"fields": {"state": {"eq": "done"}}}},
    {"id": "s150", "action": "search", "model": "stock.quant",
     "domain": [["product_id", "=", {"$var": "product"}], ["location_id", "=", {"$ref": "stock.stock_location_stock"}]],
     "save_as": "stock_quants",
     "expect": {"count": 1}},
    {"id": "s160", "action": "assert", "model": "stock.quant", "target": {"$var": "stock_quants"},
     "expect": {"fields": {"quantity": {"eq": 8}}}}
  ],
  "evidence": [
    {"label": "receipt_into_input", "model": "stock.picking", "target": {"$var": "receipts"},
     "fields": ["name", "state", "picking_type_id", "location_id", "location_dest_id"], "screenshot": true},
    {"label": "storage_transfer", "model": "stock.picking", "target": {"$var": "storage"},
     "fields": ["name", "state", "picking_type_id", "location_id", "location_dest_id"], "screenshot": true},
    {"label": "stock_quant", "model": "stock.quant", "target": {"$var": "stock_quants"},
     "fields": ["product_id", "location_id", "quantity"], "screenshot": false}
  ]
}
