{
  "format": "ofa.scenario/1",
  "id": "accounting_invoice_payment_reconcile",
  "area": "accounting",
  "odoo_version": "20.0",
  "edition": "community",
  "description": "A domestic customer invoice with a 30-day term is posted and paid in full through the register-payment wizard, which reconciles the payment with the receivable line. A second invoice is paid partly by a standalone payment that is then reconciled by hand from the invoice (outstanding credit), leaving the rest open. Needs the accounting setup plan (outstanding account on the bank journal's inbound manual method).",
  "requires": {"modules": ["account"]},
  "preconditions": [
    {"id": "p010", "action": "search", "model": "account.payment.method.line",
     "domain": [["id", "=", {"$ref": "__ofa__.bank_inbound_manual"}],
                ["payment_account_id", "=", {"$ref": "account.1_account_journal_payment_debit_account_id"}]],
     "expect": {"count": 1}},
    {"id": "p020", "action": "search", "model": "res.partner",
     "domain": [["id", "=", {"$ref": "base.res_partner_4"}], ["property_account_position_id", "=", false]],
     "expect": {"count": 1}}
  ],
  "steps": [
    {"id": "s010", "action": "create", "model": "product.product",
     "values": {"name": "OFA scenario consulting day", "type": "service", "list_price": 500.0,
                "taxes_id": {"$set": [{"$ref": "account.1_sale_tax_template"}]}},
     "save_as": "product"},
    {"id": "s020", "action": "create", "model": "account.move",
     "values": {"move_type": "out_invoice", "partner_id": {"$ref": "base.res_partner_4"},
                "invoice_payment_term_id": {"$ref": "account.account_payment_term_30days"},
                "invoice_line_ids": {"$create": [{"product_id": {"$var": "product"}, "quantity": 2, "price_unit": 500.0}]}},
     "save_as": "inv"},
    {"id": "s030", "action": "assert", "model": "account.move", "target": {"$var": "inv"},
     "expect": {"fields": {"state": {"eq": "draft"}, "amount_untaxed": {"eq": 1000.0}, "amount_tax": {"eq": 150.0},
                           "amount_total": {"eq": 1150.0},
                           "invoice_payment_term_id": {"eq": {"$ref": "account.account_payment_term_30days"}}}}},
    {"id": "s040", "action": "call", "model": "account.move", "target": {"$var": "inv"}, "method": "action_post"},
    {"id": "s050", "action": "assert", "model": "account.move", "target": {"$var": "inv"},
     "expect": {"fields": {"state": {"eq": "posted"}, "payment_state": {"eq": "not_paid"}, "amount_residual": {"eq": 1150.0}}}},
    {"id": "s060", "action": "search", "model": "account.move.line",
     "domain": [["move_id", "=", {"$var": "inv"}], ["display_type", "=", "payment_term"]],
     "save_as": "inv_receivable", "expect": {"count": 1}},
    {"id": "s070", "action": "call", "model": "account.move", "target": {"$var": "inv"}, "method": "action_register_payment",
     "wizards": {"account.payment.register": "action_create_payments"}},
    {"id": "s080", "action": "assert", "model": "account.move", "target": {"$var": "inv"},
     "expect": {"fields": {"amount_residual": {"eq": 0.0}, "payment_state": {"in": ["paid", "in_payment"]}}}},
    {"id": "s090", "action": "search", "model": "account.payment",
     "domain": [["invoice_ids", "=", {"$var": "inv"}]], "save_as": "payment", "expect": {"count": 1}},
    {"id": "s100", "action": "assert", "model": "account.payment", "target": {"$var": "payment"},
     "expect": {"fields": {"payment_type": {"eq": "inbound"}, "amount": {"eq": 1150.0}, "state": {"in": ["paid", "reconciled"]},
                           "move_id": {"ne": false},
                           "outstanding_account_id": {"eq": {"$ref": "account.1_account_journal_payment_debit_account_id"}}}}},
    {"id": "s110", "action": "assert", "model": "account.move.line", "target": {"$var": "inv_receivable"},
     "expect": {"fields": {"reconciled": {"eq": true}, "amount_residual": {"eq": 0.0}, "matching_number": {"ne": false}}}},
    {"id": "s120", "action": "create", "model": "account.move",
     "values": {"move_type": "out_invoice", "partner_id": {"$ref": "base.res_partner_4"},
                "invoice_line_ids": {"$create": [{"product_id": {"$var": "product"}, "quantity": 1, "price_unit": 200.0}]}},
     "save_as": "inv2"},
    {"id": "s130", "action": "call", "model": "account.move", "target": {"$var": "inv2"}, "method": "action_post"},
    {"id": "s140", "action": "assert", "model": "account.move", "target": {"$var": "inv2"},
     "expect": {"fields": {"state": {"eq": "posted"}, "amount_total": {"eq": 230.0}, "amount_residual": {"eq": 230.0}}}},
    {"id": "s150", "action": "create", "model": "account.payment",
     "values": {"payment_type": "inbound", "partner_type": "customer", "partner_id": {"$ref": "base.res_partner_4"},
                "amount": 100.0, "journal_id": {"$ref": "account.1_bank"},
                "payment_method_line_id": {"$ref": "__ofa__.bank_inbound_manual"}},
     "save_as": "payment2"},
    {"id": "s160", "action": "call", "model": "account.payment", "target": {"$var": "payment2"}, "method": "action_post"},
    {"id": "s170", "action": "assert", "model": "account.payment", "target": {"$var": "payment2"},
     "expect": {"fields": {"state": {"eq": "paid"}, "move_id": {"ne": false}, "is_reconciled": {"eq": false}}}},
    {"id": "s180", "action": "search", "model": "account.move.line",
     "domain": [["payment_id", "=", {"$var": "payment2"}], ["account_type", "=", "asset_receivable"]],
     "save_as": "payment2_receivable", "expect": {"count": 1}},
    {"id": "s190", "action": "call", "model": "account.move", "target": {"$var": "inv2"}, "method": "js_assign_outstanding_line",
     "params": {"line_id": {"$search": {"model": "account.move.line",
                                        "domain": [["payment_id", "=", {"$var": "payment2"}], ["account_type", "=", "asset_receivable"]]}}}},
    {"id": "s200", "action": "assert", "model": "account.move", "target": {"$var": "inv2"},
     "expect": {"fields": {"payment_state": {"eq": "partial"}, "amount_residual": {"eq": 130.0}}}},
    {"id": "s210", "action": "assert", "model": "account.move.line", "target": {"$var": "payment2_receivable"},
     "expect": {"fields": {"reconciled": {"eq": true}, "amount_residual": {"eq": 0.0}}}},
    {"id": "s220", "action": "assert", "model": "account.payment", "target": {"$var": "payment2"},
     "expect": {"fields": {"is_reconciled": {"eq": true}, "reconciled_invoice_ids": {"contains": {"$var": "inv2"}}}}}
  ],
  "evidence": [
    {"label": "paid_invoice", "model": "account.move", "target": {"$var": "inv"},
     "fields": ["name", "state", "payment_state", "amount_total", "amount_residual", "invoice_date_due"], "screenshot": true},
    {"label": "payment", "model": "account.payment", "target": {"$var": "payment"},
     "fields": ["name", "state", "amount", "journal_id", "outstanding_account_id", "move_id"], "screenshot": true},
    {"label": "partially_paid_invoice", "model": "account.move", "target": {"$var": "inv2"},
     "fields": ["name", "state", "payment_state", "amount_total", "amount_residual"], "screenshot": true}
  ]
}
