{
  "format": "ofa.scenario/1",
  "id": "accounting_fiscal_position_export",
  "area": "accounting",
  "odoo_version": "20.0",
  "edition": "community",
  "description": "A product taxed with the domestic 15% sales tax is invoiced to an export customer whose fiscal position maps that tax to 0% through the 20.0 tax-side mapping (fiscal_position_ids + original_tax_ids on the 0% tax), and to a domestic customer, who keeps 15%. Verified by reading tax_ids on the invoice lines, never by calling map_tax. Needs the accounting setup plan.",
  "requires": {"modules": ["account"]},
  "preconditions": [
    {"id": "p010", "action": "search", "model": "account.tax",
     "domain": [["id", "=", {"$ref": "__ofa__.export_sale_tax_0"}],
                ["fiscal_position_ids", "in", [{"$ref": "__ofa__.export_fpos"}]],
                ["original_tax_ids", "in", [{"$ref": "account.1_sale_tax_template"}]]],
     "expect": {"count": 1}},
    {"id": "p020", "action": "search", "model": "res.partner",
     "domain": [["id", "=", {"$ref": "base.res_partner_4"}], ["property_account_position_id", "=", false]],
     "expect": {"count": 1}}
  ],
  "steps": [
    {"id": "s010", "action": "assert", "model": "account.fiscal.position", "target": {"$ref": "__ofa__.export_fpos"},
     "expect": {"fields": {"tax_ids": {"contains": {"$ref": "__ofa__.export_sale_tax_0"}}, "is_domestic": {"eq": false},
                           "auto_apply": {"eq": false}}}},
    {"id": "s020", "action": "assert", "model": "account.tax", "target": {"$ref": "__ofa__.export_sale_tax_0"},
     "expect": {"fields": {"amount": {"eq": 0.0}, "type_tax_use": {"eq": "sale"}, "is_domestic": {"eq": false},
                           "original_tax_ids": {"eq": [{"$ref": "account.1_sale_tax_template"}]}}}},
    {"id": "s030", "action": "assert", "model": "res.partner", "target": {"$ref": "__ofa__.export_customer"},
     "expect": {"fields": {"property_account_position_id": {"eq": {"$ref": "__ofa__.export_fpos"}},
                           "country_id": {"eq": {"$ref": "base.ca"}}}}},
    {"id": "s040", "action": "create", "model": "product.product",
     "values": {"name": "OFA scenario export good", "type": "consu", "list_price": 100.0,
                "taxes_id": {"$set": [{"$ref": "account.1_sale_tax_template"}]}},
     "save_as": "product"},
    {"id": "s050", "action": "create", "model": "account.move",
     "values": {"move_type": "out_invoice", "partner_id": {"$ref": "__ofa__.export_customer"},
                "invoice_line_ids": {"$create": [{"product_id": {"$var": "product"}, "quantity": 2, "price_unit": 100.0}]}},
     "save_as": "export_inv"},
    {"id": "s060", "action": "assert", "model": "account.move", "target": {"$var": "export_inv"},
     "expect": {"fields": {"fiscal_position_id": {"eq": {"$ref": "__ofa__.export_fpos"}},
                           "amount_untaxed": {"eq": 200.0}, "amount_tax": {"eq": 0.0}, "amount_total": {"eq": 200.0}}}},
    {"id": "s070", "action": "assert", "model": "account.move.line",
     "target": {"$search": {"model": "account.move.line", "domain": [["move_id", "=", {"$var": "export_inv"}], ["display_type", "=", "product"]]}},
     "expect": {"fields": {"tax_ids": {"eq": [{"$ref": "__ofa__.export_sale_tax_0"}]}}}},
    {"id": "s080", "action": "create", "model": "account.move",
     "values": {"move_type": "out_invoice", "partner_id": {"$ref": "base.res_partner_4"},
                "invoice_line_ids": {"$create": [{"product_id": {"$var": "product"}, "quantity": 2, "price_unit": 100.0}]}},
     "save_as": "domestic_inv"},
    {"id": "s090", "action": "assert", "model": "account.move", "target": {"$var": "domestic_inv"},
     "expect": {"fields": {"fiscal_position_id": {"eq": {"$ref": "account.1_template_generic_domestic_fiscal_position"}},
                           "amount_tax": {"eq": 30.0}, "amount_total": {"eq": 230.0}}}},
    {"id": "s100", "action": "assert", "model": "account.move.line",
     "target": {"$search": {"model": "account.move.line", "domain": [["move_id", "=", {"$var": "domestic_inv"}], ["display_type", "=", "product"]]}},
     "expect": {"fields": {"tax_ids": {"eq": [{"$ref": "account.1_sale_tax_template"}]}}}},
    {"id": "s110", "action": "call", "model": "account.move", "target": {"$var": "export_inv"}, "method": "action_post"},
    {"id": "s120", "action": "assert", "model": "account.move", "target": {"$var": "export_inv"},
     "expect": {"fields": {"state": {"eq": "posted"}, "amount_tax": {"eq": 0.0}, "amount_residual": {"eq": 200.0},
                           "fiscal_position_id": {"eq": {"$ref": "__ofa__.export_fpos"}}}}},
    {"id": "s130", "action": "assert", "model": "account.move.line",
     "target": {"$search": {"model": "account.move.line", "domain": [["move_id", "=", {"$var": "export_inv"}], ["display_type", "=", "product"]]}},
     "expect": {"fields": {"tax_ids": {"eq": [{"$ref": "__ofa__.export_sale_tax_0"}]}, "price_subtotal": {"eq": 200.0}}}}
  ],
  "evidence": [
    {"label": "export_invoice", "model": "account.move", "target": {"$var": "export_inv"},
     "fields": ["name", "state", "partner_id", "fiscal_position_id", "amount_untaxed", "amount_tax", "amount_total"], "screenshot": true},
    {"label": "export_invoice_line", "model": "account.move.line",
     "target": {"$search": {"model": "account.move.line", "domain": [["move_id", "=", {"$var": "export_inv"}], ["display_type", "=", "product"]]}},
     "fields": ["product_id", "quantity", "price_unit", "tax_ids", "price_subtotal"], "screenshot": false},
    {"label": "export_tax", "model": "account.tax", "target": {"$ref": "__ofa__.export_sale_tax_0"},
     "fields": ["name", "amount", "fiscal_position_ids", "original_tax_ids"], "screenshot": true}
  ]
}
