{
  "format": "ofa.scenario/1",
  "id": "l10n_mx_ppd_payment_complement",
  "area": "l10n_mx",
  "odoo_version": "20.0",
  "edition": "enterprise",
  "description": "A credit sale (PPD) from the demo company INNOVACION VALOR Y DESARROLLO is stamped as CFDI 4.0 with the Quadrum (finkok) test PAC; a partial customer payment by bank transfer (payment way 03) is posted, reconciled with the invoice, and reported to the SAT with the invoice's Update Payments action, which stamps a payment complement (CFDI type P) for the payment. Proves both stamps by reading back l10n_mx_edi_cfdi_state = sent and a fiscal folio (UUID) on the invoice and on the payment, plus the CFDI document rows in states invoice_sent and payment_sent; the SAT status is not asserted. Needs the l10n_mx setup plan (outstanding account on the bank journal's inbound manual method, without which the payment has no journal entry and no complement). Needs network access to the third-party test PAC: a run without network gets a PAC error, not a pass. The demo CSD of this company expires on 2027-05-18; after that date stamping fails until the template is rebuilt from a newer l10n_mx_edi.",
  "requires": {"modules": ["l10n_mx_edi"]},
  "preconditions": [
    {"id": "p010", "action": "search", "model": "account.payment.method.line",
     "domain": [["id", "=", {"$ref": "__ofa__.mx_bank_inbound_manual"}],
                ["payment_account_id", "=", {"$ref": "account.4_account_journal_payment_debit_account_id"}]],
     "expect": {"count": 1}},
    {"id": "p020", "action": "search", "model": "res.company",
     "domain": [["id", "=", {"$ref": "base.demo_company_mx"}], ["l10n_mx_edi_pac", "=", "finkok"],
                ["l10n_mx_edi_pac_test_env", "=", true]],
     "expect": {"count": 1}},
    {"id": "p030", "action": "search", "model": "certificate.certificate",
     "domain": [["company_id", "=", {"$ref": "base.demo_company_mx"}], ["scope", "=", "cfdi_csd"], ["is_valid", "=", true]],
     "expect": {"count": 1}}
  ],
  "steps": [
    {"id": "s010", "action": "create", "model": "product.product",
     "values": {"name": "OFA MX installation service", "type": "service", "list_price": 5000.0,
                "unspsc_code_id": {"$ref": "product_unspsc.unspsc_code_80101501"},
                "taxes_id": {"$set": [{"$ref": "account.4_tax12"}]}},
     "save_as": "product"},
    {"id": "s020", "action": "create", "model": "account.move",
     "values": {"move_type": "out_invoice", "company_id": {"$ref": "base.demo_company_mx"},
                "journal_id": {"$ref": "account.4_sale"},
                "partner_id": {"$ref": "l10n_mx_edi.demo_partner_quadrum_1"},
                "l10n_mx_edi_payment_method_id": {"$ref": "l10n_mx_edi.payment_method_transferencia"},
                "l10n_mx_edi_payment_policy": "PPD",
                "invoice_line_ids": {"$create": [{"product_id": {"$var": "product"}, "quantity": 1, "price_unit": 5000.0}]}},
     "save_as": "inv"},
    {"id": "s030", "action": "assert", "model": "account.move", "target": {"$var": "inv"},
     "expect": {"fields": {"amount_untaxed": {"eq": 5000.0}, "amount_tax": {"eq": 800.0}, "amount_total": {"eq": 5800.0},
                           "l10n_mx_edi_is_cfdi_needed": {"eq": true}, "l10n_mx_edi_payment_policy": {"eq": "PPD"}}}},
    {"id": "s040", "action": "call", "model": "account.move", "target": {"$var": "inv"}, "method": "action_post"},
    {"id": "s050", "action": "call", "model": "account.move", "target": {"$var": "inv"}, "method": "action_send_and_print",
     "wizards": {"account.move.send.wizard": "action_send_and_print"}},
    {"id": "s060", "action": "assert", "model": "account.move", "target": {"$var": "inv"},
     "expect": {"fields": {"l10n_mx_edi_cfdi_state": {"eq": "sent"}, "l10n_mx_edi_cfdi_uuid": {"ne": false},
                           "payment_state": {"eq": "not_paid"}}}},
    {"id": "s070", "action": "create", "model": "account.payment",
     "values": {"payment_type": "inbound", "partner_type": "customer",
                "partner_id": {"$ref": "l10n_mx_edi.demo_partner_quadrum_1"},
                "company_id": {"$ref": "base.demo_company_mx"}, "journal_id": {"$ref": "account.4_bank"},
                "payment_method_line_id": {"$ref": "__ofa__.mx_bank_inbound_manual"},
                "amount": 2900.0,
                "l10n_mx_edi_payment_method_id": {"$ref": "l10n_mx_edi.payment_method_transferencia"}},
     "save_as": "payment"},
    {"id": "s080", "action": "call", "model": "account.payment", "target": {"$var": "payment"}, "method": "action_post"},
    {"id": "s090", "action": "assert", "model": "account.payment", "target": {"$var": "payment"},
     "expect": {"fields": {"state": {"eq": "paid"}, "move_id": {"ne": false},
                           "l10n_mx_edi_is_cfdi_needed": {"eq": true}}}},
    {"id": "s100", "action": "call", "model": "account.move", "target": {"$var": "inv"}, "method": "js_assign_outstanding_line",
     "params": {"line_id": {"$search": {"model": "account.move.line",
                                        "domain": [["payment_id", "=", {"$var": "payment"}], ["account_type", "=", "asset_receivable"]]}}}},
    {"id": "s110", "action": "assert", "model": "account.move", "target": {"$var": "inv"},
     "expect": {"fields": {"payment_state": {"eq": "partial"}, "amount_residual": {"eq": 2900.0}}}},
    {"id": "s120", "action": "call", "model": "account.move", "target": {"$var": "inv"},
     "method": "l10n_mx_edi_cfdi_invoice_try_update_payments"},
    {"id": "s130", "action": "assert", "model": "account.payment", "target": {"$var": "payment"},
     "expect": {"fields": {"l10n_mx_edi_cfdi_state": {"eq": "sent"}, "l10n_mx_edi_cfdi_uuid": {"ne": false},
                           "reconciled_invoice_ids": {"contains": {"$var": "inv"}}}}},
    {"id": "s140", "action": "search", "model": "l10n_mx_edi.document",
     "domain": [["invoice_ids", "in", [{"$var": "inv"}]], ["state", "=", "invoice_sent"]],
     "save_as": "invoice_doc", "expect": {"count": 1}},
    {"id": "s150", "action": "search", "model": "l10n_mx_edi.document",
     "domain": [["move_id.origin_payment_id", "=", {"$var": "payment"}], ["state", "=", "payment_sent"]],
     "save_as": "payment_doc", "expect": {"count": 1}},
    {"id": "s160", "action": "assert", "model": "l10n_mx_edi.document", "target": {"$var": "payment_doc"},
     "expect": {"fields": {"attachment_uuid": {"ne": false}, "invoice_ids": {"contains": {"$var": "inv"}}}}}
  ],
  "evidence": [
    {"label": "ppd_invoice", "model": "account.move", "target": {"$var": "inv"},
     "fields": ["name", "state", "payment_state", "amount_total", "amount_residual", "l10n_mx_edi_cfdi_state",
                "l10n_mx_edi_cfdi_uuid", "l10n_mx_edi_payment_policy"], "screenshot": true},
    {"label": "payment_complement", "model": "account.payment", "target": {"$var": "payment"},
     "fields": ["name", "state", "amount", "l10n_mx_edi_payment_method_id", "l10n_mx_edi_cfdi_state", "l10n_mx_edi_cfdi_uuid"],
     "screenshot": true},
    {"label": "payment_cfdi_document", "model": "l10n_mx_edi.document", "target": {"$var": "payment_doc"},
     "fields": ["state", "sat_state", "attachment_uuid", "datetime"], "screenshot": false}
  ]
}
