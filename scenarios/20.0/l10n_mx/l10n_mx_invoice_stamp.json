{
  "format": "ofa.scenario/1",
  "id": "l10n_mx_invoice_stamp",
  "area": "l10n_mx",
  "odoo_version": "20.0",
  "edition": "enterprise",
  "description": "A Mexican customer invoice (PUE, payment way 03 Transferencia, IVA 16%) from the demo company ZAPATERIA URTADO ÑERI is posted and sent through the Send wizard, which stamps it as CFDI 4.0 with the Solucion Factible test PAC and the company's demo CSD. Proves the stamp by reading back l10n_mx_edi_cfdi_state = sent, a fiscal folio (UUID) and the CFDI document row in state invoice_sent; the SAT status is not asserted (the test SAT does not confirm test stamps). Needs network access to the third-party test PAC: a run without network gets a PAC error, not a pass. The demo CSD of this company expires on 2027-01-18; after that date stamping fails until the template is rebuilt from a newer l10n_mx_edi. Needs no setup plan.",
  "requires": {"modules": ["l10n_mx_edi"]},
  "preconditions": [
    {"id": "p010", "action": "search", "model": "res.company",
     "domain": [["id", "=", {"$ref": "base.demo_company_2_mx"}], ["l10n_mx_edi_pac", "=", "solfact"],
                ["l10n_mx_edi_pac_test_env", "=", true], ["l10n_mx_edi_fiscal_regime", "=", "601"]],
     "expect": {"count": 1}},
    {"id": "p020", "action": "search", "model": "certificate.certificate",
     "domain": [["company_id", "=", {"$ref": "base.demo_company_2_mx"}], ["scope", "=", "cfdi_csd"], ["is_valid", "=", true]],
     "expect": {"count": 1}},
    {"id": "p030", "action": "search", "model": "res.partner",
     "domain": [["id", "=", {"$ref": "l10n_mx_edi.demo_partner_sapien_1"}], ["vat", "=", "XIA190128J61"],
                ["country_id", "=", {"$ref": "base.mx"}], ["zip", "!=", false]],
     "expect": {"count": 1}}
  ],
  "steps": [
    {"id": "s010", "action": "create", "model": "product.product",
     "values": {"name": "OFA MX consulting hour", "type": "service", "list_price": 1000.0,
                "unspsc_code_id": {"$ref": "product_unspsc.unspsc_code_80101501"},
                "taxes_id": {"$set": [{"$ref": "account.5_tax12"}]}},
     "save_as": "product"},
    {"id": "s020", "action": "create", "model": "account.move",
     "values": {"move_type": "out_invoice", "company_id": {"$ref": "base.demo_company_2_mx"},
                "journal_id": {"$ref": "account.5_sale"},
                "partner_id": {"$ref": "l10n_mx_edi.demo_partner_sapien_1"},
                "l10n_mx_edi_payment_method_id": {"$ref": "l10n_mx_edi.payment_method_transferencia"},
                "l10n_mx_edi_payment_policy": "PUE",
                "invoice_line_ids": {"$create": [{"product_id": {"$var": "product"}, "quantity": 2, "price_unit": 1000.0}]}},
     "save_as": "inv"},
    {"id": "s030", "action": "assert", "model": "account.move", "target": {"$var": "inv"},
     "expect": {"fields": {"state": {"eq": "draft"}, "amount_untaxed": {"eq": 2000.0}, "amount_tax": {"eq": 320.0},
                           "amount_total": {"eq": 2320.0}, "l10n_mx_edi_is_cfdi_needed": {"eq": true},
                           "l10n_mx_edi_cfdi_to_public": {"eq": false}, "l10n_mx_edi_usage": {"eq": "G03"},
                           "l10n_mx_edi_payment_policy": {"eq": "PUE"},
                           "l10n_mx_edi_payment_method_id": {"eq": {"$ref": "l10n_mx_edi.payment_method_transferencia"}}}}},
    {"id": "s040", "action": "call", "model": "account.move", "target": {"$var": "inv"}, "method": "action_post"},
    {"id": "s050", "action": "call", "model": "account.move", "target": {"$var": "inv"}, "method": "action_send_and_print",
     "wizards": {"account.move.send.wizard": "action_send_and_print"}},
    {"id": "s060", "action": "assert", "model": "account.move", "target": {"$var": "inv"},
     "expect": {"fields": {"state": {"eq": "posted"}, "l10n_mx_edi_cfdi_state": {"eq": "sent"},
                           "l10n_mx_edi_cfdi_uuid": {"ne": false}, "l10n_mx_edi_cfdi_attachment_id": {"ne": false}}}},
    {"id": "s070", "action": "search", "model": "l10n_mx_edi.document",
     "domain": [["invoice_ids", "in", [{"$var": "inv"}]], ["state", "=", "invoice_sent"]],
     "save_as": "cfdi_doc", "expect": {"count": 1}},
    {"id": "s080", "action": "assert", "model": "l10n_mx_edi.document", "target": {"$var": "cfdi_doc"},
     "expect": {"fields": {"attachment_uuid": {"ne": false}, "message": {"eq": false}}}}
  ],
  "evidence": [
    {"label": "stamped_invoice", "model": "account.move", "target": {"$var": "inv"},
     "fields": ["name", "state", "amount_total", "l10n_mx_edi_cfdi_state", "l10n_mx_edi_cfdi_uuid",
                "l10n_mx_edi_payment_policy", "l10n_mx_edi_payment_method_id", "l10n_mx_edi_usage"], "screenshot": true},
    {"label": "cfdi_document", "model": "l10n_mx_edi.document", "target": {"$var": "cfdi_doc"},
     "fields": ["state", "sat_state", "attachment_uuid", "datetime"], "screenshot": false}
  ]
}
