{
  "format": "ofa.scenario/1",
  "id": "sales_quote_to_invoice",
  "area": "sales_crm",
  "odoo_version": "20.0",
  "edition": "community",
  "description": "A quotation for a delivered-quantities product is confirmed, its delivery is validated, and the regular invoice is created from the order and posted. Proves the quote -> order -> delivery -> invoice chain and that invoicing follows delivered quantities.",
  "requires": {"modules": ["sale_management", "sale_stock", "account"]},
  "preconditions": [
    {"id": "p010", "action": "search", "model": "res.partner",
     "domain": [["id", "=", {"$ref": "base.res_partner_12"}]],
     "expect": {"count": 1}}
  ],
  "steps": [
    {"id": "s010", "action": "create", "model": "product.product",
     "values": {"name": "OFA scenario desk (delivered qty)", "type": "consu", "is_storable": false,
                "invoice_policy": "delivery", "list_price": 100.0, "sale_ok": true},
     "save_as": "product"},
    {"id": "s020", "action": "assert", "model": "product.product", "target": {"$var": "product"},
     "expect": {"fields": {"invoice_policy": {"eq": "delivery"}, "type": {"eq": "consu"}}}},
    {"id": "s030", "action": "create", "model": "sale.order",
     "values": {"partner_id": {"$ref": "base.res_partner_12"},
                "order_line": {"$create": [{"product_id": {"$var": "product"}, "product_uom_qty": 3}]}},
     "save_as": "so"},
    {"id": "s040", "action": "assert", "model": "sale.order", "target": {"$var": "so"},
     "expect": {"fields": {"state": {"eq": "draft"}, "amount_untaxed": {"gt": 0}}}},
    {"id": "s050", "action": "call", "model": "sale.order", "target": {"$var": "so"}, "method": "action_confirm"},
    {"id": "s060", "action": "assert", "model": "sale.order", "target": {"$var": "so"},
     "expect": {"fields": {"state": {"eq": "sale"}, "invoice_status": {"eq": "no"}}}},
    {"id": "s070", "action": "search", "model": "stock.picking",
     "domain": [["sale_id", "=", {"$var": "so"}]], "save_as": "pickings",
     "expect": {"count": 1}},
    {"id": "s080", "action": "call", "model": "stock.picking",
     "target": {"$search": {"model": "stock.picking", "domain": [["sale_id", "=", {"$var": "so"}]]}},
     "method": "button_validate"},
    {"id": "s090", "action": "assert", "model": "stock.picking",
     "target": {"$search": {"model": "stock.picking", "domain": [["sale_id", "=", {"$var": "so"}]]}},
     "expect": {"fields": {"state": {"eq": "done"}}}},
    {"id": "s100", "action": "assert", "model": "sale.order.line",
     "target": {"$search": {"model": "sale.order.line", "domain": [["order_id", "=", {"$var": "so"}], ["display_type", "=", false]]}},
     "expect": {"fields": {"qty_delivered": {"eq": 3}, "qty_to_invoice": {"eq": 3}, "qty_invoiced": {"eq": 0}}}},
    {"id": "s110", "action": "assert", "model": "sale.order", "target": {"$var": "so"},
     "expect": {"fields": {"invoice_status": {"eq": "to invoice"}}}},
    {"id": "s120", "action": "create", "model": "sale.advance.payment.inv",
     "values": {"sale_order_ids": {"$set": [{"$var": "so"}]}, "advance_payment_method": "delivered"},
     "save_as": "invoice_wizard"},
    {"id": "s130", "action": "call", "model": "sale.advance.payment.inv", "target": {"$var": "invoice_wizard"},
     "method": "create_invoices"},
    {"id": "s140", "action": "search", "model": "account.move",
     "domain": [["invoice_line_ids.sale_line_ids.order_id", "=", {"$var": "so"}], ["move_type", "=", "out_invoice"]],
     "save_as": "invoices",
     "expect": {"count": 1}},
    {"id": "s150", "action": "call", "model": "account.move",
     "target": {"$search": {"model": "account.move", "domain": [["invoice_line_ids.sale_line_ids.order_id", "=", {"$var": "so"}], ["move_type", "=", "out_invoice"]]}},
     "method": "action_post"},
    {"id": "s160", "action": "assert", "model": "account.move",
     "target": {"$search": {"model": "account.move", "domain": [["invoice_line_ids.sale_line_ids.order_id", "=", {"$var": "so"}], ["move_type", "=", "out_invoice"]]}},
     "expect": {"fields": {"state": {"eq": "posted"}, "move_type": {"eq": "out_invoice"},
                           "payment_state": {"eq": "not_paid"}, "amount_total": {"gt": 0}}}},
    {"id": "s170", "action": "assert", "model": "sale.order.line",
     "target": {"$search": {"model": "sale.order.line", "domain": [["order_id", "=", {"$var": "so"}], ["display_type", "=", false]]}},
     "expect": {"fields": {"qty_invoiced": {"eq": 3}, "qty_to_invoice": {"eq": 0}}}},
    {"id": "s180", "action": "assert", "model": "sale.order", "target": {"$var": "so"},
     "expect": {"fields": {"invoice_status": {"eq": "invoiced"}, "invoice_count": {"eq": 1}}}}
  ],
  "evidence": [
    {"label": "confirmed order", "model": "sale.order", "target": {"$var": "so"},
     "fields": ["name", "state", "invoice_status", "amount_total"], "screenshot": true},
    {"label": "validated delivery", "model": "stock.picking",
     "target": {"$search": {"model": "stock.picking", "domain": [["sale_id", "=", {"$var": "so"}]]}},
     "fields": ["name", "state", "origin"], "screenshot": false},
    {"label": "posted invoice", "model": "account.move",
     "target": {"$search": {"model": "account.move", "domain": [["invoice_line_ids.sale_line_ids.order_id", "=", {"$var": "so"}], ["move_type", "=", "out_invoice"]]}},
     "fields": ["name", "state", "payment_state", "amount_total", "invoice_origin"], "screenshot": true}
  ]
}
