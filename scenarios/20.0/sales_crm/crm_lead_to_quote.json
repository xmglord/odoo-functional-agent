{
  "format": "ofa.scenario/1",
  "id": "crm_lead_to_quote",
  "area": "sales_crm",
  "odoo_version": "20.0",
  "edition": "community",
  "description": "A lead for an existing customer is converted to an opportunity, a quotation is created from it and confirmed, and the opportunity is marked won. Proves the lead -> opportunity -> quotation -> order link (opportunity_id), the quotation and order counters on the opportunity, and the won status. The expected revenue update on confirmation only happens when the order currency equals the company currency, which holds for the demo customer.",
  "requires": {"modules": ["crm", "sale_management", "sale_crm"]},
  "preconditions": [
    {"id": "p010", "action": "search", "model": "res.partner",
     "domain": [["id", "=", {"$ref": "base.res_partner_12"}]],
     "expect": {"count": 1}},
    {"id": "p020", "action": "search", "model": "crm.stage",
     "domain": [["is_won", "=", true]],
     "expect": {"count": {"gte": 1}}}
  ],
  "steps": [
    {"id": "s010", "action": "create", "model": "crm.lead",
     "values": {"name": "OFA scenario: meeting room fit-out", "type": "lead",
                "partner_id": {"$ref": "base.res_partner_12"}, "expected_revenue": 0},
     "save_as": "lead"},
    {"id": "s020", "action": "assert", "model": "crm.lead", "target": {"$var": "lead"},
     "expect": {"fields": {"type": {"eq": "lead"}, "active": {"eq": true}}}},
    {"id": "s030", "action": "call", "model": "crm.lead", "target": {"$var": "lead"},
     "method": "action_convert_to_opportunity"},
    {"id": "s040", "action": "assert", "model": "crm.lead", "target": {"$var": "lead"},
     "expect": {"fields": {"type": {"eq": "opportunity"}, "won_status": {"eq": "pending"},
                           "date_conversion": {"ne": false}, "stage_id": {"ne": false}}}},
    {"id": "s050", "action": "create", "model": "product.product",
     "values": {"name": "OFA scenario fit-out service", "type": "service",
                "invoice_policy": "order", "list_price": 500.0, "sale_ok": true},
     "save_as": "service"},
    {"id": "s060", "action": "create", "model": "sale.order",
     "values": {"partner_id": {"$ref": "base.res_partner_12"},
                "opportunity_id": {"$var": "lead"},
                "origin": "OFA scenario: meeting room fit-out",
                "order_line": {"$create": [{"product_id": {"$var": "service"}, "product_uom_qty": 2}]}},
     "save_as": "quote"},
    {"id": "s070", "action": "assert", "model": "crm.lead", "target": {"$var": "lead"},
     "expect": {"fields": {"quotation_count": {"eq": 1}, "sale_order_count": {"eq": 0}}}},
    {"id": "s080", "action": "call", "model": "sale.order", "target": {"$var": "quote"}, "method": "action_confirm"},
    {"id": "s090", "action": "assert", "model": "sale.order", "target": {"$var": "quote"},
     "expect": {"fields": {"state": {"eq": "sale"}, "amount_untaxed": {"gt": 0}}}},
    {"id": "s100", "action": "assert", "model": "crm.lead", "target": {"$var": "lead"},
     "expect": {"fields": {"quotation_count": {"eq": 0}, "sale_order_count": {"eq": 1},
                           "expected_revenue": {"gt": 0}}}},
    {"id": "s110", "action": "call", "model": "crm.lead", "target": {"$var": "lead"}, "method": "action_set_won"},
    {"id": "s120", "action": "assert", "model": "crm.lead", "target": {"$var": "lead"},
     "expect": {"fields": {"won_status": {"eq": "won"}, "probability": {"eq": 100}}}}
  ],
  "evidence": [
    {"label": "won opportunity", "model": "crm.lead", "target": {"$var": "lead"},
     "fields": ["name", "type", "stage_id", "won_status", "expected_revenue", "sale_order_count"], "screenshot": true},
    {"label": "confirmed order", "model": "sale.order", "target": {"$var": "quote"},
     "fields": ["name", "state", "opportunity_id", "amount_total"], "screenshot": true}
  ]
}
