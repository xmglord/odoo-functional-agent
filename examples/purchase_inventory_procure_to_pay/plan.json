{
  "format": "ofa.plan/1",
  "title": "Harbor Fresh: purchase to vendor bill with replenishment, two-step receipts, FEFO and 3-way matching",
  "odoo_version": "20.0",
  "edition": "enterprise",
  "areas": ["purchase_inventory", "accounting"],
  "operations": [
    {"id": "op_010_install_product_expiry", "type": "install_modules", "modules": ["product_expiry"],
     "depends_on": [],
     "rationale": "Expiration dates on lots and the FEFO removal strategy come from product_expiry.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/lots_serials_packages.md"]},
    {"id": "op_015_install_3way_match", "type": "install_modules", "modules": ["account_3way_match"],
     "depends_on": [], "edition": "enterprise",
     "rationale": "Release to Pay flags vendor bills whose quantity or price differs from what was ordered and received.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/bill_control.md"]},
    {"id": "op_020_po_approval", "type": "set_settings", "company": {"$ref": "base.main_company"},
     "values": {"po_order_approval": true, "po_double_validation_amount": 50000},
     "depends_on": [],
     "rationale": "Orders with a total of 50,000 or more stop in 'to approve' until a purchase manager approves them.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/purchase_approval.md"]},
    {"id": "op_030_multi_step_routes", "type": "set_settings", "company": {"$ref": "base.main_company"},
     "values": {"group_stock_multi_locations": true, "group_stock_adv_location": true},
     "depends_on": [],
     "rationale": "Multi-Step Routes (with Storage Locations set explicitly) is needed for two-step receipts.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/multi_step_routes.md"]},
    {"id": "op_040_lots", "type": "set_settings", "company": {"$ref": "base.main_company"},
     "values": {"group_stock_production_lot": true},
     "depends_on": [],
     "rationale": "Lots & Serial Numbers must be on for lot tracking of food products (already on in the template).",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/lots_serials_packages.md"]},
    {"id": "op_050_warehouse_two_steps", "type": "upsert_record", "model": "stock.warehouse", "key": "hf_warehouse",
     "values": {"reception_steps": "two_steps"},
     "match": [["id", "=", {"$ref": "stock.warehouse0"}]],
     "depends_on": ["op_030_multi_step_routes"],
     "rationale": "Receive into WH/Input (dock, counted), then a storage transfer moves goods to WH/Stock.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/multi_step_routes.md"]},
    {"id": "op_060_receipt_backorder_always", "type": "upsert_record", "model": "stock.picking.type", "key": "hf_receipt_type",
     "values": {"create_backorder": "always"},
     "match": [["id", "=", {"$ref": "stock.picking_type_in"}]],
     "depends_on": ["op_050_warehouse_two_steps"],
     "rationale": "A partial receipt always leaves a backorder on the same purchase order for the missing quantity.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/backorders.md"]},
    {"id": "op_070_categ_food", "type": "upsert_record", "model": "product.category", "key": "hf_categ_food",
     "values": {"name": "Food", "removal_strategy_id": {"$search": {"model": "product.removal", "domain": [["method", "=", "fefo"]]}}},
     "match": [["name", "=", "Food"], ["parent_id", "=", false]],
     "depends_on": ["op_010_install_product_expiry"],
     "rationale": "Food products are picked First Expiry, First Out through the category's removal strategy.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/lots_serials_packages.md#alternatives"]},
    {"id": "op_080_categ_cleaning", "type": "upsert_record", "model": "product.category", "key": "hf_categ_cleaning",
     "values": {"name": "Cleaning Supplies"},
     "match": [["name", "=", "Cleaning Supplies"], ["parent_id", "=", false]],
     "depends_on": [],
     "rationale": "Cleaning supplies keep the warehouse default removal (FIFO); no expiry tracking.",
     "knowledge_refs": []},
    {"id": "op_090_vendor_bayline", "type": "upsert_record", "model": "res.partner", "key": "hf_vendor_bayline",
     "values": {"name": "Bayline Foods Supply (demo)"},
     "match": [["name", "=", "Bayline Foods Supply (demo)"]], "depends_on": [],
     "rationale": "Fictional food vendor: small quantities, highest unit price, short lead time.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/reordering_rules.md"]},
    {"id": "op_100_vendor_northpoint", "type": "upsert_record", "model": "res.partner", "key": "hf_vendor_northpoint",
     "values": {"name": "Northpoint Wholesale Grocers (demo)"},
     "match": [["name", "=", "Northpoint Wholesale Grocers (demo)"]], "depends_on": [],
     "rationale": "Fictional food vendor: cheapest price from 100 units, longer lead time.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/reordering_rules.md"]},
    {"id": "op_110_vendor_coastal", "type": "upsert_record", "model": "res.partner", "key": "hf_vendor_coastal",
     "values": {"name": "Coastal Pantry Traders (demo)"},
     "match": [["name", "=", "Coastal Pantry Traders (demo)"]], "depends_on": [],
     "rationale": "Fictional food vendor with a 500-unit minimum at a price above Northpoint's (the native-rule counter-example).",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/reordering_rules.md"]},
    {"id": "op_120_vendor_clearwave", "type": "upsert_record", "model": "res.partner", "key": "hf_vendor_clearwave",
     "values": {"name": "Clearwave Janitorial Co. (demo)"},
     "match": [["name", "=", "Clearwave Janitorial Co. (demo)"]], "depends_on": [],
     "rationale": "Fictional cleaning-supplies vendor, no minimum quantity.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/reordering_rules.md"]},
    {"id": "op_130_vendor_brightside", "type": "upsert_record", "model": "res.partner", "key": "hf_vendor_brightside",
     "values": {"name": "Brightside Cleaning Supply (demo)"},
     "match": [["name", "=", "Brightside Cleaning Supply (demo)"]], "depends_on": [],
     "rationale": "Fictional cleaning-supplies vendor, cheaper from 50 units.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/reordering_rules.md"]},
    {"id": "op_140_product_tomatoes", "type": "upsert_record", "model": "product.template", "key": "hf_product_tomatoes",
     "values": {"name": "Canned Diced Tomatoes 400 g", "default_code": "HF-FD-001", "type": "consu", "store_by": "lot",
                "categ_id": {"$ref": "__ofa__.hf_categ_food"}, "purchase_ok": true, "sale_ok": true,
                "purchase_method": "receive", "use_expiration_date": true, "expiration_time": 540,
                "standard_price": 1.15},
     "match": [["default_code", "=", "HF-FD-001"]],
     "depends_on": ["op_010_install_product_expiry", "op_040_lots", "op_070_categ_food"],
     "rationale": "Food product: tracked by lot, expiry date per lot, billed on received quantities, FEFO through its category.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/lots_serials_packages.md", "knowledge/20.0/purchase_inventory/bill_control.md"]},
    {"id": "op_150_product_floor_cleaner", "type": "upsert_record", "model": "product.template", "key": "hf_product_floor_cleaner",
     "values": {"name": "Floor Cleaner Concentrate 5 L", "default_code": "HF-CL-001", "type": "consu", "store_by": "quantity",
                "categ_id": {"$ref": "__ofa__.hf_categ_cleaning"}, "purchase_ok": true, "sale_ok": true,
                "purchase_method": "receive", "standard_price": 8.0},
     "match": [["default_code", "=", "HF-CL-001"]],
     "depends_on": ["op_080_categ_cleaning"],
     "rationale": "Fast-moving cleaning product, stocked by quantity, billed on received quantities, replenished by min/max.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/reordering_rules.md", "knowledge/20.0/purchase_inventory/bill_control.md"]},
    {"id": "op_160_product_dish_soap", "type": "upsert_record", "model": "product.template", "key": "hf_product_dish_soap",
     "values": {"name": "Dish Soap 5 L", "default_code": "HF-CL-002", "type": "consu", "store_by": "quantity",
                "categ_id": {"$ref": "__ofa__.hf_categ_cleaning"}, "purchase_ok": true, "sale_ok": true,
                "purchase_method": "receive", "standard_price": 6.0},
     "match": [["default_code", "=", "HF-CL-002"]],
     "depends_on": ["op_080_categ_cleaning"],
     "rationale": "Cleaning product stocked by quantity and billed on received quantities.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/bill_control.md"]},
    {"id": "op_200_price_tomatoes_bayline", "type": "upsert_record", "model": "product.supplierinfo", "key": "hf_si_tomatoes_bayline",
     "values": {"product_tmpl_id": {"$ref": "__ofa__.hf_product_tomatoes"}, "partner_id": {"$ref": "__ofa__.hf_vendor_bayline"},
                "price": 1.20, "min_qty": 1, "delay": 3, "sequence": 10},
     "match": [["product_tmpl_id", "=", {"$ref": "__ofa__.hf_product_tomatoes"}], ["partner_id", "=", {"$ref": "__ofa__.hf_vendor_bayline"}]],
     "depends_on": ["op_140_product_tomatoes", "op_090_vendor_bayline"],
     "rationale": "Bayline sells tomatoes at 1.20 from 1 unit, 3 days lead time.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/reordering_rules.md"]},
    {"id": "op_210_price_tomatoes_northpoint", "type": "upsert_record", "model": "product.supplierinfo", "key": "hf_si_tomatoes_northpoint",
     "values": {"product_tmpl_id": {"$ref": "__ofa__.hf_product_tomatoes"}, "partner_id": {"$ref": "__ofa__.hf_vendor_northpoint"},
                "price": 1.00, "min_qty": 100, "delay": 7, "sequence": 10},
     "match": [["product_tmpl_id", "=", {"$ref": "__ofa__.hf_product_tomatoes"}], ["partner_id", "=", {"$ref": "__ofa__.hf_vendor_northpoint"}]],
     "depends_on": ["op_140_product_tomatoes", "op_100_vendor_northpoint"],
     "rationale": "Northpoint sells tomatoes at 1.00 from 100 units, 7 days lead time.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/reordering_rules.md"]},
    {"id": "op_220_price_tomatoes_coastal", "type": "upsert_record", "model": "product.supplierinfo", "key": "hf_si_tomatoes_coastal",
     "values": {"product_tmpl_id": {"$ref": "__ofa__.hf_product_tomatoes"}, "partner_id": {"$ref": "__ofa__.hf_vendor_coastal"},
                "price": 1.10, "min_qty": 500, "delay": 5, "sequence": 10},
     "match": [["product_tmpl_id", "=", {"$ref": "__ofa__.hf_product_tomatoes"}], ["partner_id", "=", {"$ref": "__ofa__.hf_vendor_coastal"}]],
     "depends_on": ["op_140_product_tomatoes", "op_110_vendor_coastal"],
     "rationale": "Coastal sells tomatoes at 1.10 from 500 units, 5 days lead time.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/reordering_rules.md"]},
    {"id": "op_230_price_cleaner_clearwave", "type": "upsert_record", "model": "product.supplierinfo", "key": "hf_si_cleaner_clearwave",
     "values": {"product_tmpl_id": {"$ref": "__ofa__.hf_product_floor_cleaner"}, "partner_id": {"$ref": "__ofa__.hf_vendor_clearwave"},
                "price": 9.00, "min_qty": 1, "delay": 2, "sequence": 10},
     "match": [["product_tmpl_id", "=", {"$ref": "__ofa__.hf_product_floor_cleaner"}], ["partner_id", "=", {"$ref": "__ofa__.hf_vendor_clearwave"}]],
     "depends_on": ["op_150_product_floor_cleaner", "op_120_vendor_clearwave"],
     "rationale": "Clearwave sells floor cleaner at 9.00 from 1 unit, 2 days lead time.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/reordering_rules.md"]},
    {"id": "op_240_price_cleaner_brightside", "type": "upsert_record", "model": "product.supplierinfo", "key": "hf_si_cleaner_brightside",
     "values": {"product_tmpl_id": {"$ref": "__ofa__.hf_product_floor_cleaner"}, "partner_id": {"$ref": "__ofa__.hf_vendor_brightside"},
                "price": 7.50, "min_qty": 50, "delay": 6, "sequence": 10},
     "match": [["product_tmpl_id", "=", {"$ref": "__ofa__.hf_product_floor_cleaner"}], ["partner_id", "=", {"$ref": "__ofa__.hf_vendor_brightside"}]],
     "depends_on": ["op_150_product_floor_cleaner", "op_130_vendor_brightside"],
     "rationale": "Brightside sells floor cleaner at 7.50 from 50 units, 6 days lead time.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/reordering_rules.md"]},
    {"id": "op_250_price_soap_clearwave", "type": "upsert_record", "model": "product.supplierinfo", "key": "hf_si_soap_clearwave",
     "values": {"product_tmpl_id": {"$ref": "__ofa__.hf_product_dish_soap"}, "partner_id": {"$ref": "__ofa__.hf_vendor_clearwave"},
                "price": 6.00, "min_qty": 1, "delay": 2, "sequence": 10},
     "match": [["product_tmpl_id", "=", {"$ref": "__ofa__.hf_product_dish_soap"}], ["partner_id", "=", {"$ref": "__ofa__.hf_vendor_clearwave"}]],
     "depends_on": ["op_160_product_dish_soap", "op_120_vendor_clearwave"],
     "rationale": "Clearwave sells dish soap at 6.00 from 1 unit, 2 days lead time.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/bill_control.md"]},
    {"id": "op_300_reorder_floor_cleaner", "type": "upsert_record", "model": "stock.warehouse.orderpoint", "key": "hf_rr_floor_cleaner",
     "values": {"product_id": {"$search": {"model": "product.product", "domain": [["default_code", "=", "HF-CL-001"]]}},
                "warehouse_id": {"$ref": "stock.warehouse0"}, "location_id": {"$ref": "stock.stock_location_stock"},
                "product_min_qty": 20, "product_max_qty": 100, "trigger": "auto"},
     "match": [["product_id.default_code", "=", "HF-CL-001"], ["location_id", "=", {"$ref": "stock.stock_location_stock"}]],
     "depends_on": ["op_150_product_floor_cleaner", "op_230_price_cleaner_clearwave", "op_240_price_cleaner_brightside", "op_050_warehouse_two_steps"],
     "rationale": "Min 20 / max 100 automatic rule: falling below 20 prepares a draft RFQ up to 100 for the proposed vendor.",
     "knowledge_refs": ["knowledge/20.0/purchase_inventory/reordering_rules.md"]}
  ]
}
