{
  "format": "ofa.scenario/1", "id": "hf_receive_partial_and_bill", "area": "purchase_inventory", "odoo_version": "20.0",
  "edition": "enterprise", "company": {"$ref": "base.main_company"},
  "description": "Needs 4 and 6: a PO of 10 dish soap at Clearwave's 6.00; 6 arrive at the dock (WH/Input) and the receipt is validated without a wizard, leaving a backorder of 4 on the same PO; the storage transfer puts 6 on the shelf (WH/Stock). The bill from the PO carries 6 (received), is releasable to pay, turns to exception when the price differs and back when it matches, and posts. A second bill for 4 more units (10 billed vs 6 received) is an exception.",
  "requires": {"modules": ["purchase_stock", "account_3way_match"]},
  "steps": [
    {"id": "s010", "action": "create", "model": "purchase.order",
     "values": {"partner_id": {"$ref": "__ofa__.hf_vendor_clearwave"},
                "order_line": {"$create": [{"product_id": {"$search": {"model": "product.product", "domain": [["default_code", "=", "HF-CL-002"]]}},
                                            "product_qty": 10}]}},
     "save_as": "po"},
    {"id": "s020", "action": "search", "model": "purchase.order.line", "domain": [["order_id", "=", {"$var": "po"}]],
     "save_as": "po_line", "expect": {"count": 1}},
    {"id": "s030", "action": "assert", "model": "purchase.order.line", "target": {"$var": "po_line"},
     "expect": {"fields": {"price_unit": {"eq": 6.0}}}},
    {"id": "s040", "action": "call", "model": "purchase.order", "target": {"$var": "po"}, "method": "button_confirm"},
    {"id": "s050", "action": "assert", "model": "purchase.order", "target": {"$var": "po"},
     "expect": {"fields": {"state": {"eq": "purchase"}, "invoice_status": {"eq": "no"}}}},
    {"id": "s060", "action": "search", "model": "stock.picking", "domain": [["purchase_id", "=", {"$var": "po"}]],
     "save_as": "receipts", "expect": {"count": 1}},
    {"id": "s070", "action": "assert", "model": "stock.picking", "target": {"$var": "receipts"},
     "expect": {"fields": {"picking_type_id": {"eq": {"$ref": "stock.picking_type_in"}},
                           "location_dest_id": {"eq": {"$search": {"model": "stock.location", "domain": [["complete_name", "=", "WH/Input"]]}}}}}},
    {"id": "s080", "action": "search", "model": "stock.move", "domain": [["picking_id", "in", {"$var": "receipts"}]],
     "save_as": "receipt_moves", "expect": {"count": 1}},
    {"id": "s090", "action": "write", "model": "stock.move", "target": {"$var": "receipt_moves"}, "values": {"quantity": 6}},
    {"id": "s100", "action": "call", "model": "stock.picking", "target": {"$var": "receipts"}, "method": "button_validate"},
    {"id": "s110", "action": "assert", "model": "stock.picking", "target": {"$var": "receipts"},
     "expect": {"fields": {"state": {"eq": "done"}}}},
    {"id": "s120", "action": "search", "model": "stock.picking", "domain": [["backorder_id", "in", {"$var": "receipts"}]],
     "save_as": "backorders", "expect": {"count": 1}},
    {"id": "s130", "action": "assert", "model": "stock.picking", "target": {"$var": "backorders"},
     "expect": {"fields": {"purchase_id": {"eq": {"$var": "po"}}, "state": {"eq": "assigned"}}}},
    {"id": "s140", "action": "assert", "model": "stock.move",
     "target": {"$search": {"model": "stock.move", "domain": [["picking_id", "in", {"$var": "backorders"}]]}},
     "expect": {"fields": {"product_uom_qty": {"eq": 4}}}},
    {"id": "s150", "action": "search", "model": "purchase.order", "domain": [["partner_id", "=", {"$ref": "__ofa__.hf_vendor_clearwave"}]],
     "expect": {"count": 1}},
    {"id": "s160", "action": "search", "model": "stock.picking",
     "domain": [["move_ids.move_orig_ids.picking_id", "in", {"$var": "receipts"}]], "save_as": "storage", "expect": {"count": 1}},
    {"id": "s170", "action": "assert", "model": "stock.picking", "target": {"$var": "storage"},
     "expect": {"fields": {"location_id": {"eq": {"$search": {"model": "stock.location", "domain": [["complete_name", "=", "WH/Input"]]}}},
                           "location_dest_id": {"eq": {"$ref": "stock.stock_location_stock"}}}}},
    {"id": "s180", "action": "call", "model": "stock.picking", "target": {"$var": "storage"}, "method": "button_validate"},
    {"id": "s190", "action": "assert", "model": "stock.picking", "target": {"$var": "storage"},
     "expect": {"fields": {"state": {"eq": "done"}}}},
    {"id": "s200", "action": "assert", "model": "stock.quant",
     "target": {"$search": {"model": "stock.quant", "domain": [["product_id.default_code", "=", "HF-CL-002"], ["location_id", "=", {"$ref": "stock.stock_location_stock"}]]}},
     "expect": {"fields": {"quantity": {"eq": 6}}}},
    {"id": "s210", "action": "assert", "model": "purchase.order.line", "target": {"$var": "po_line"},
     "expect": {"fields": {"qty_received": {"eq": 6}, "qty_to_invoice": {"eq": 6}}}},
    {"id": "s220", "action": "assert", "model": "purchase.order", "target": {"$var": "po"},
     "expect": {"fields": {"receipt_status": {"eq": "partial"}, "invoice_status": {"eq": "to invoice"}}}},
    {"id": "s230", "action": "call", "model": "purchase.order", "target": {"$var": "po"}, "method": "action_create_invoice"},
    {"id": "s240", "action": "search", "model": "account.move",
     "domain": [["move_type", "=", "in_invoice"], ["invoice_line_ids.purchase_line_id.order_id", "=", {"$var": "po"}]],
     "save_as": "bill1", "expect": {"count": 1}},
    {"id": "s250", "action": "search", "model": "account.move.line",
     "domain": [["move_id", "in", {"$var": "bill1"}], ["purchase_line_id", "!=", false]], "save_as": "bill1_line", "expect": {"count": 1}},
    {"id": "s260", "action": "assert", "model": "account.move.line", "target": {"$var": "bill1_line"},
     "expect": {"fields": {"quantity": {"eq": 6}, "price_unit": {"eq": 6.0}, "can_be_paid": {"eq": "yes"}}}},
    {"id": "s270", "action": "assert", "model": "account.move", "target": {"$var": "bill1"},
     "expect": {"fields": {"release_to_pay": {"eq": "yes"}}}},
    {"id": "s280", "action": "write", "model": "account.move.line", "target": {"$var": "bill1_line"}, "values": {"price_unit": 6.5}},
    {"id": "s290", "action": "assert", "model": "account.move", "target": {"$var": "bill1"},
     "expect": {"fields": {"release_to_pay": {"eq": "exception"}}}},
    {"id": "s300", "action": "write", "model": "account.move.line", "target": {"$var": "bill1_line"}, "values": {"price_unit": 6.0}},
    {"id": "s310", "action": "assert", "model": "account.move", "target": {"$var": "bill1"},
     "expect": {"fields": {"release_to_pay": {"eq": "yes"}}}},
    {"id": "s320", "action": "write", "model": "account.move", "target": {"$var": "bill1"}, "values": {"invoice_date": "2026-10-27"}},
    {"id": "s330", "action": "call", "model": "account.move", "target": {"$var": "bill1"}, "method": "action_post"},
    {"id": "s340", "action": "assert", "model": "account.move", "target": {"$var": "bill1"},
     "expect": {"fields": {"state": {"eq": "posted"}, "release_to_pay": {"eq": "yes"}}}},
    {"id": "s350", "action": "call", "model": "purchase.order", "target": {"$var": "po"}, "method": "action_create_invoice"},
    {"id": "s360", "action": "search", "model": "account.move",
     "domain": [["move_type", "=", "in_invoice"], ["invoice_line_ids.purchase_line_id.order_id", "=", {"$var": "po"}], ["id", "not in", {"$var": "bill1"}]],
     "save_as": "bill2", "expect": {"count": 1}},
    {"id": "s370", "action": "search", "model": "account.move.line",
     "domain": [["move_id", "in", {"$var": "bill2"}], ["purchase_line_id", "!=", false]], "save_as": "bill2_line", "expect": {"count": 1}},
    {"id": "s380", "action": "write", "model": "account.move.line", "target": {"$var": "bill2_line"}, "values": {"quantity": 4}},
    {"id": "s390", "action": "assert", "model": "account.move", "target": {"$var": "bill2"},
     "expect": {"fields": {"release_to_pay": {"eq": "exception"}}}}
  ],
  "evidence": [
    {"label": "partial_receipt", "model": "stock.picking", "target": {"$var": "receipts"}, "fields": ["name", "state", "location_dest_id", "origin"], "screenshot": true},
    {"label": "backorder", "model": "stock.picking", "target": {"$var": "backorders"}, "fields": ["name", "state", "backorder_id", "purchase_id"], "screenshot": true},
    {"label": "storage_transfer", "model": "stock.picking", "target": {"$var": "storage"}, "fields": ["name", "state", "location_id", "location_dest_id"], "screenshot": false},
    {"label": "bill_received_qty", "model": "account.move", "target": {"$var": "bill1"}, "fields": ["name", "state", "release_to_pay", "amount_untaxed"], "screenshot": true},
    {"label": "bill_over_billed", "model": "account.move", "target": {"$var": "bill2"}, "fields": ["name", "state", "release_to_pay", "amount_untaxed"], "screenshot": true}
  ]
}
