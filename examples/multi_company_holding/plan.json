{
  "format": "ofa.plan/1",
  "title": "Ridgeline group: three companies, a branch, inter-company trade and group reporting",
  "odoo_version": "20.0",
  "edition": "enterprise",
  "areas": ["multi_company", "accounting", "sales_crm", "purchase_inventory"],
  "operations": [
    {
      "id": "op_010_install_modules",
      "type": "install_modules",
      "modules": ["accountant", "account_inter_company_rules", "sale_purchase_inter_company_rules", "sale_purchase_stock_inter_company_rules"],
      "depends_on": [],
      "rationale": "Full Accounting (Bookkeeper role, group reports) and the Enterprise inter-company rules that mirror orders and invoices.",
      "knowledge_refs": ["knowledge/20.0/accounting/invoicing_vs_accounting_apps.md", "knowledge/20.0/multi_company/intercompany_rules.md"],
      "edition": "enterprise"
    },
    {
      "id": "op_020_company_holdings",
      "type": "upsert_record",
      "model": "res.company",
      "key": "co_holdings",
      "values": {"name": "Ridgeline Holdings", "country_id": {"$ref": "base.us"}, "vat": "00-0000101"},
      "match": [["name", "=", "Ridgeline Holdings"]],
      "depends_on": ["op_010_install_modules"],
      "rationale": "Holdings is its own legal entity: a root company with its own US chart, journals and numbering.",
      "knowledge_refs": ["knowledge/20.0/multi_company/companies_and_branches.md", "knowledge/20.0/accounting/chart_of_accounts.md"],
      "edition": "community"
    },
    {
      "id": "op_030_company_foods",
      "type": "upsert_record",
      "model": "res.company",
      "key": "co_foods",
      "values": {"name": "Ridgeline Foods", "country_id": {"$ref": "base.us"}, "vat": "00-0000102"},
      "match": [["name", "=", "Ridgeline Foods"]],
      "depends_on": ["op_010_install_modules"],
      "rationale": "Foods is its own legal entity: a root company with its own US chart, journals and numbering.",
      "knowledge_refs": ["knowledge/20.0/multi_company/companies_and_branches.md", "knowledge/20.0/accounting/chart_of_accounts.md"],
      "edition": "community"
    },
    {
      "id": "op_040_company_logistics",
      "type": "upsert_record",
      "model": "res.company",
      "key": "co_logistics",
      "values": {"name": "Ridgeline Logistics", "country_id": {"$ref": "base.us"}, "vat": "00-0000103"},
      "match": [["name", "=", "Ridgeline Logistics"]],
      "depends_on": ["op_010_install_modules"],
      "rationale": "Logistics is its own legal entity: a root company with its own US chart, journals and numbering.",
      "knowledge_refs": ["knowledge/20.0/multi_company/companies_and_branches.md", "knowledge/20.0/accounting/chart_of_accounts.md"],
      "edition": "community"
    },
    {
      "id": "op_050_company_eliminations",
      "type": "upsert_record",
      "model": "res.company",
      "key": "co_eliminations",
      "values": {"name": "Ridgeline Eliminations", "country_id": {"$ref": "base.us"}},
      "match": [["name", "=", "Ridgeline Eliminations"]],
      "depends_on": ["op_010_install_modules"],
      "rationale": "A bookkeeping-only company with the same US chart that holds the monthly inter-company elimination entries.",
      "knowledge_refs": ["knowledge/20.0/multi_company/multi_company_reporting.md", "knowledge/20.0/multi_company/companies_and_branches.md"],
      "edition": "community"
    },
    {
      "id": "op_060_branch_riverside",
      "type": "upsert_record",
      "model": "res.company",
      "key": "co_foods_branch",
      "values": {"name": "Ridgeline Foods Riverside Branch", "parent_id": {"$ref": "__ofa__.co_foods"}, "country_id": {"$ref": "base.us"}, "vat": "00-0000102"},
      "match": [["name", "=", "Ridgeline Foods Riverside Branch"]],
      "depends_on": ["op_030_company_foods"],
      "rationale": "The Riverside branch is part of Foods' legal entity: a branch shares Foods' chart, taxes and books but has its own documents and users.",
      "knowledge_refs": ["knowledge/20.0/multi_company/companies_and_branches.md", "knowledge/20.0/multi_company/shared_vs_company_records.md"],
      "edition": "community"
    },
    {
      "id": "op_070_warehouse_foods",
      "type": "upsert_record",
      "model": "stock.warehouse",
      "key": "wh_foods",
      "company": {"$ref": "__ofa__.co_foods"},
      "values": {"name": "Foods Main Warehouse", "code": "RFM", "company_id": {"$ref": "__ofa__.co_foods"}},
      "match": [["company_id", "=", {"$ref": "__ofa__.co_foods"}], ["code", "=", "RFM"]],
      "depends_on": ["op_030_company_foods"],
      "rationale": "A new company gets no warehouse; Foods needs one for its stock and for its purchase orders.",
      "knowledge_refs": ["knowledge/20.0/multi_company/companies_and_branches.md"],
      "edition": "community"
    },
    {
      "id": "op_080_warehouse_branch",
      "type": "upsert_record",
      "model": "stock.warehouse",
      "key": "wh_foods_branch",
      "company": {"$ref": "__ofa__.co_foods_branch"},
      "values": {"name": "Foods Riverside Warehouse", "code": "RFR", "company_id": {"$ref": "__ofa__.co_foods_branch"}},
      "match": [["company_id", "=", {"$ref": "__ofa__.co_foods_branch"}], ["code", "=", "RFR"]],
      "depends_on": ["op_060_branch_riverside"],
      "rationale": "The branch's stock lives in a warehouse owned by the branch, which Foods' main-warehouse users do not see.",
      "knowledge_refs": ["knowledge/20.0/multi_company/companies_and_branches.md", "knowledge/20.0/multi_company/shared_vs_company_records.md"],
      "edition": "community"
    },
    {
      "id": "op_090_warehouse_logistics",
      "type": "upsert_record",
      "model": "stock.warehouse",
      "key": "wh_logistics",
      "company": {"$ref": "__ofa__.co_logistics"},
      "values": {"name": "Logistics Yard", "code": "RLY", "company_id": {"$ref": "__ofa__.co_logistics"}},
      "match": [["company_id", "=", {"$ref": "__ofa__.co_logistics"}], ["code", "=", "RLY"]],
      "depends_on": ["op_040_company_logistics", "op_010_install_modules"],
      "rationale": "The inter-company sales order generated in Logistics needs a warehouse, and a new company has none.",
      "knowledge_refs": ["knowledge/20.0/multi_company/intercompany_rules.md", "knowledge/20.0/multi_company/companies_and_branches.md"],
      "edition": "community"
    },
    {
      "id": "op_100_journal_branch_sales",
      "type": "upsert_record",
      "model": "account.journal",
      "key": "journal_branch_sales",
      "company": {"$ref": "__ofa__.co_foods_branch"},
      "values": {"name": "Riverside Branch Invoices", "code": "RVINV", "type": "sale", "sequence": 1, "company_id": {"$ref": "__ofa__.co_foods_branch"}},
      "match": [["company_id", "=", {"$ref": "__ofa__.co_foods_branch"}], ["code", "=", "RVINV"]],
      "depends_on": ["op_060_branch_riverside"],
      "rationale": "Branch invoices get their own journal and RVINV numbering inside Foods' books, so they are identifiable as the branch's.",
      "knowledge_refs": ["knowledge/20.0/accounting/journals.md", "knowledge/20.0/multi_company/companies_and_branches.md"],
      "edition": "community"
    },
    {
      "id": "op_110_product_haul",
      "type": "upsert_record",
      "model": "product.template",
      "key": "prod_haul",
      "company": {"$ref": "__ofa__.co_logistics"},
      "values": {"name": "Refrigerated haul (per trip)", "type": "service", "invoice_policy": "order", "purchase_method": "purchase", "sale_ok": true, "purchase_ok": true, "list_price": 850.0, "company_id": false},
      "match": [["name", "=", "Refrigerated haul (per trip)"], ["company_id", "=", false]],
      "depends_on": ["op_040_company_logistics", "op_030_company_foods"],
      "rationale": "The haul is a shared service product: Foods buys it and Logistics sells it, invoiced on ordered quantities.",
      "knowledge_refs": ["knowledge/20.0/multi_company/shared_vs_company_records.md", "knowledge/20.0/multi_company/intercompany_rules.md", "knowledge/20.0/sales_crm/invoicing_policy.md"],
      "edition": "community"
    },
    {
      "id": "op_120_product_management_fee",
      "type": "upsert_record",
      "model": "product.template",
      "key": "prod_mgmt_fee",
      "company": {"$ref": "__ofa__.co_holdings"},
      "values": {"name": "Group management fee (monthly)", "type": "service", "invoice_policy": "order", "purchase_method": "purchase", "sale_ok": true, "purchase_ok": true, "list_price": 12000.0, "company_id": false},
      "match": [["name", "=", "Group management fee (monthly)"], ["company_id", "=", false]],
      "depends_on": ["op_020_company_holdings", "op_030_company_foods", "op_040_company_logistics"],
      "rationale": "The fee product is shared so the generated vendor bills in Foods and Logistics can carry it without a company crossover.",
      "knowledge_refs": ["knowledge/20.0/multi_company/shared_vs_company_records.md", "knowledge/20.0/multi_company/intercompany_rules.md"],
      "edition": "community"
    },
    {
      "id": "op_130_product_frozen_case",
      "type": "upsert_record",
      "model": "product.template",
      "key": "prod_frozen_case",
      "company": {"$ref": "__ofa__.co_foods"},
      "values": {"name": "Frozen mixed vegetables (case)", "type": "consu", "sale_ok": true, "purchase_ok": true, "list_price": 30.0, "company_id": false},
      "match": [["name", "=", "Frozen mixed vegetables (case)"], ["company_id", "=", false]],
      "depends_on": ["op_030_company_foods", "op_040_company_logistics", "op_020_company_holdings", "op_050_company_eliminations"],
      "rationale": "A sample catalog product with no company_id, visible to every company and branch of the group.",
      "knowledge_refs": ["knowledge/20.0/multi_company/shared_vs_company_records.md"],
      "edition": "community"
    },
    {
      "id": "op_140_pricelist_foods",
      "type": "upsert_record",
      "model": "product.pricelist",
      "key": "pricelist_foods",
      "company": {"$ref": "__ofa__.co_foods"},
      "values": {"name": "Ridgeline Foods Wholesale", "company_id": {"$ref": "__ofa__.co_foods"}, "currency_id": {"$ref": "base.USD"}},
      "match": [["name", "=", "Ridgeline Foods Wholesale"]],
      "depends_on": ["op_030_company_foods"],
      "rationale": "Prices are per company: Foods' wholesale prices live in a pricelist that belongs to Foods (and its branch).",
      "knowledge_refs": ["knowledge/20.0/sales_crm/pricelists.md", "knowledge/20.0/multi_company/shared_vs_company_records.md"],
      "edition": "community"
    },
    {
      "id": "op_150_pricelist_foods_item",
      "type": "upsert_record",
      "model": "product.pricelist.item",
      "key": "pricelist_foods_frozen_case",
      "company": {"$ref": "__ofa__.co_foods"},
      "values": {"pricelist_id": {"$ref": "__ofa__.pricelist_foods"}, "applied_on": "1_product", "product_tmpl_id": {"$ref": "__ofa__.prod_frozen_case"}, "compute_price": "fixed", "fixed_price": 26.5, "min_quantity": 0},
      "match": [["pricelist_id", "=", {"$ref": "__ofa__.pricelist_foods"}], ["product_tmpl_id", "=", {"$ref": "__ofa__.prod_frozen_case"}]],
      "depends_on": ["op_140_pricelist_foods", "op_130_product_frozen_case"],
      "rationale": "Foods sells the shared case at its own price (26.50) while the shared list price stays 30.00 for other companies.",
      "knowledge_refs": ["knowledge/20.0/sales_crm/pricelists.md"],
      "edition": "community"
    },
    {
      "id": "op_160_customer_harborview",
      "type": "upsert_record",
      "model": "res.partner",
      "key": "cust_harborview",
      "company": {"$ref": "__ofa__.co_foods"},
      "values": {"name": "Harborview Grocers", "company_id": false, "country_id": {"$ref": "base.us"}, "property_product_pricelist": {"$ref": "__ofa__.pricelist_foods"}},
      "match": [["name", "=", "Harborview Grocers"]],
      "depends_on": ["op_140_pricelist_foods"],
      "rationale": "One shared customer record for the group; its pricelist is company-dependent, so in Foods it gets Foods' wholesale pricelist.",
      "knowledge_refs": ["knowledge/20.0/multi_company/shared_vs_company_records.md", "knowledge/20.0/sales_crm/pricelists.md"],
      "edition": "community"
    },
    {
      "id": "op_170_vendor_summit_foods_terms",
      "type": "upsert_record",
      "model": "res.partner",
      "key": "vend_summit",
      "company": {"$ref": "__ofa__.co_foods"},
      "values": {"name": "Summit Packaging Supply", "company_id": false, "country_id": {"$ref": "base.us"}, "property_supplier_payment_term_id": {"$ref": "account.account_payment_term_30days"}},
      "match": [["name", "=", "Summit Packaging Supply"]],
      "depends_on": ["op_030_company_foods"],
      "rationale": "One shared vendor; Foods' negotiated terms (30 days) are stored in the company-dependent vendor payment term for Foods.",
      "knowledge_refs": ["knowledge/20.0/multi_company/shared_vs_company_records.md", "knowledge/20.0/accounting/payment_terms.md"],
      "edition": "community"
    },
    {
      "id": "op_180_vendor_summit_logistics_terms",
      "type": "upsert_record",
      "model": "res.partner",
      "key": "vend_summit_logistics_terms",
      "company": {"$ref": "__ofa__.co_logistics"},
      "values": {"property_supplier_payment_term_id": {"$ref": "account.account_payment_term_45days"}},
      "match": [["name", "=", "Summit Packaging Supply"]],
      "depends_on": ["op_170_vendor_summit_foods_terms", "op_040_company_logistics"],
      "rationale": "The same vendor gets Logistics' own terms (45 days), written in Logistics' context so Foods' value is untouched.",
      "knowledge_refs": ["knowledge/20.0/multi_company/shared_vs_company_records.md", "knowledge/20.0/accounting/payment_terms.md"],
      "edition": "community"
    },
    {
      "id": "op_200_intercompany_logistics",
      "type": "set_settings",
      "company": {"$ref": "__ofa__.co_logistics"},
      "values": {"intercompany_generate_sales_orders": true, "intercompany_generate_bills_refund": true, "intercompany_document_state": "draft"},
      "depends_on": ["op_010_install_modules", "op_040_company_logistics"],
      "rationale": "Logistics receives: a group purchase order to it becomes its draft sales order, and Holdings' fee invoice becomes its draft bill.",
      "knowledge_refs": ["knowledge/20.0/multi_company/intercompany_rules.md", "knowledge/20.0/multi_company/per_company_settings.md"],
      "edition": "enterprise"
    },
    {
      "id": "op_210_intercompany_foods",
      "type": "set_settings",
      "company": {"$ref": "__ofa__.co_foods"},
      "values": {"intercompany_generate_bills_refund": true, "intercompany_document_state": "draft"},
      "depends_on": ["op_010_install_modules", "op_030_company_foods"],
      "rationale": "Foods receives the haul and fee invoices as draft vendor bills for its accountant to check.",
      "knowledge_refs": ["knowledge/20.0/multi_company/intercompany_rules.md", "knowledge/20.0/multi_company/per_company_settings.md"],
      "edition": "enterprise"
    },
    {
      "id": "op_300_group_controller_marker",
      "type": "upsert_record",
      "model": "res.groups",
      "key": "grp_group_controller",
      "values": {"name": "Ridgeline group controller", "comment": "Marker group: journal entries only in Holdings, Foods, the Riverside branch and Eliminations."},
      "match": [["name", "=", "Ridgeline group controller"]],
      "depends_on": [],
      "rationale": "Access groups are global, so the controller needs a marker group that the posting restriction can test with user.has_group.",
      "knowledge_refs": ["knowledge/20.0/multi_company/user_company_access.md"],
      "edition": "community"
    },
    {
      "id": "op_310_controller_restrict_moves",
      "type": "upsert_record",
      "model": "ir.access",
      "key": "acc_controller_moves",
      "values": {
        "name": "Ridgeline: group controller posts only in allowed companies (entries)",
        "model_id": {"$ref": "account.model_account_move"},
        "operation": "cud",
        "domain": "[('company_id.name', 'in', ['Ridgeline Holdings', 'Ridgeline Foods', 'Ridgeline Foods Riverside Branch', 'Ridgeline Eliminations'])] if user.has_group('__ofa__.grp_group_controller') else []"
      },
      "match": [["name", "=", "Ridgeline: group controller posts only in allowed companies (entries)"]],
      "depends_on": ["op_010_install_modules", "op_300_group_controller_marker"],
      "rationale": "Global restriction on account.move create/write/delete: for the controller only, the entry's company must be on the allow-list, which excludes Logistics.",
      "knowledge_refs": ["knowledge/20.0/multi_company/shared_vs_company_records.md", "knowledge/20.0/accounting/invoicing_vs_accounting_apps.md"],
      "edition": "community"
    },
    {
      "id": "op_320_controller_restrict_move_lines",
      "type": "upsert_record",
      "model": "ir.access",
      "key": "acc_controller_move_lines",
      "values": {
        "name": "Ridgeline: group controller posts only in allowed companies (journal items)",
        "model_id": {"$ref": "account.model_account_move_line"},
        "operation": "cud",
        "domain": "[('company_id.name', 'in', ['Ridgeline Holdings', 'Ridgeline Foods', 'Ridgeline Foods Riverside Branch', 'Ridgeline Eliminations'])] if user.has_group('__ofa__.grp_group_controller') else []"
      },
      "match": [["name", "=", "Ridgeline: group controller posts only in allowed companies (journal items)"]],
      "depends_on": ["op_010_install_modules", "op_300_group_controller_marker"],
      "rationale": "Same restriction on journal items, so payments and reconciliations that write Logistics lines are blocked too.",
      "knowledge_refs": ["knowledge/20.0/multi_company/shared_vs_company_records.md", "knowledge/20.0/accounting/invoicing_vs_accounting_apps.md"],
      "edition": "community"
    },
    {
      "id": "op_500_role_foods_staff",
      "type": "upsert_record",
      "model": "res.users",
      "key": "role_foods_staff",
      "match": [["login", "=", "ofa_user_1"]],
      "values": {
        "name": "Foods staff (test identity)",
        "group_ids": {"$set": [{"$ref": "base.group_user"}, {"$ref": "sales_team.group_sale_salesman_all_leads"}, {"$ref": "purchase.group_purchase_user"}, {"$ref": "stock.group_stock_user"}, {"$ref": "account.group_account_invoice"}]},
        "company_ids": {"$set": [{"$ref": "__ofa__.co_foods"}]},
        "company_id": {"$ref": "__ofa__.co_foods"}
      },
      "depends_on": ["op_010_install_modules", "op_030_company_foods"],
      "rationale": "Test identity: a Foods employee (sales, purchase, stock, invoicing) whose only company is Foods.",
      "knowledge_refs": ["knowledge/20.0/multi_company/user_company_access.md"],
      "edition": "community"
    },
    {
      "id": "op_510_role_branch_staff",
      "type": "upsert_record",
      "model": "res.users",
      "key": "role_branch_staff",
      "match": [["login", "=", "ofa_user_2"]],
      "values": {
        "name": "Riverside branch staff (test identity)",
        "group_ids": {"$set": [{"$ref": "base.group_user"}, {"$ref": "sales_team.group_sale_salesman_all_leads"}, {"$ref": "purchase.group_purchase_user"}, {"$ref": "stock.group_stock_user"}, {"$ref": "account.group_account_invoice"}]},
        "company_ids": {"$set": [{"$ref": "__ofa__.co_foods_branch"}]},
        "company_id": {"$ref": "__ofa__.co_foods_branch"}
      },
      "depends_on": ["op_010_install_modules", "op_060_branch_riverside"],
      "rationale": "Test identity: a branch employee with the same job groups whose only company is the Riverside branch.",
      "knowledge_refs": ["knowledge/20.0/multi_company/user_company_access.md", "knowledge/20.0/multi_company/companies_and_branches.md"],
      "edition": "community"
    },
    {
      "id": "op_520_role_group_controller",
      "type": "upsert_record",
      "model": "res.users",
      "key": "role_group_controller",
      "match": [["login", "=", "ofa_user_3"]],
      "values": {
        "name": "Group controller (test identity)",
        "group_ids": {"$set": [{"$ref": "base.group_user"}, {"$ref": "account.group_account_user"}, {"$ref": "__ofa__.grp_group_controller"}, {"$ref": "base.group_multi_company"}]},
        "company_ids": {"$set": [{"$ref": "__ofa__.co_holdings"}, {"$ref": "__ofa__.co_foods"}, {"$ref": "__ofa__.co_foods_branch"}, {"$ref": "__ofa__.co_logistics"}, {"$ref": "__ofa__.co_eliminations"}]},
        "company_id": {"$ref": "__ofa__.co_holdings"}
      },
      "depends_on": ["op_010_install_modules", "op_300_group_controller_marker", "op_020_company_holdings", "op_030_company_foods", "op_040_company_logistics", "op_050_company_eliminations", "op_060_branch_riverside"],
      "rationale": "Test identity: the controller as Bookkeeper in every company, carrying the marker group the posting restriction checks.",
      "knowledge_refs": ["knowledge/20.0/multi_company/user_company_access.md", "knowledge/20.0/accounting/invoicing_vs_accounting_apps.md"],
      "edition": "community"
    }
  ]
}
