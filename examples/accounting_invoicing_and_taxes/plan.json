{
  "format": "ofa.plan/1",
  "title": "Lumen Ridge Studios: invoicing, payments and monthly close",
  "odoo_version": "20.0",
  "edition": "enterprise",
  "areas": [
    "accounting",
    "sales_crm"
  ],
  "operations": [
    {
      "id": "op_010_install_accountant",
      "type": "install_modules",
      "modules": [
        "accountant"
      ],
      "depends_on": [],
      "rationale": "Bank reconciliation, the monthly close and analytic reports need the full Accounting app (accountant), not Invoicing only.",
      "knowledge_refs": [
        "knowledge/20.0/accounting/invoicing_vs_accounting_apps.md"
      ],
      "edition": "enterprise"
    },
    {
      "id": "op_020_settings",
      "type": "set_settings",
      "company": {
        "$ref": "base.main_company"
      },
      "values": {
        "group_analytic_accounting": true,
        "group_product_pricelist": true
      },
      "depends_on": [
        "op_010_install_accountant"
      ],
      "rationale": "Analytic distribution on invoice and bill lines, and pricelists so European customers get a euro pricelist.",
      "knowledge_refs": [
        "knowledge/20.0/accounting/analytic_accounting.md"
      ],
      "edition": "community"
    },
    {
      "id": "op_030_currency_eur",
      "type": "upsert_record",
      "model": "res.currency",
      "key": "eur",
      "values": {
        "active": true
      },
      "match": [
        [
          "name",
          "=",
          "EUR"
        ],
        [
          "active",
          "in",
          [
            true,
            false
          ]
        ]
      ],
      "depends_on": [
        "op_010_install_accountant"
      ],
      "rationale": "Activating EUR turns on multi-currency; euro invoices and the euro bank journal need it.",
      "knowledge_refs": [
        "knowledge/20.0/accounting/multi_currency.md"
      ],
      "edition": "community"
    },
    {
      "id": "op_040_bank_eur",
      "type": "upsert_record",
      "model": "account.journal",
      "key": "bank_eur",
      "company": {
        "$ref": "base.main_company"
      },
      "values": {
        "name": "Bank EUR",
        "code": "BNKEU",
        "type": "bank",
        "currency_id": {
          "$ref": "__ofa__.eur"
        },
        "company_id": {
          "$ref": "base.main_company"
        }
      },
      "match": [
        [
          "code",
          "=",
          "BNKEU"
        ],
        [
          "company_id",
          "=",
          {
            "$ref": "base.main_company"
          }
        ]
      ],
      "depends_on": [
        "op_030_currency_eur"
      ],
      "rationale": "The euro bank account is its own bank journal in EUR, with its own liquidity account and statements.",
      "knowledge_refs": [
        "knowledge/20.0/accounting/journals.md",
        "knowledge/20.0/accounting/multi_currency.md"
      ],
      "edition": "community"
    },
    {
      "id": "op_050_export_fpos",
      "type": "upsert_record",
      "model": "account.fiscal.position",
      "key": "export_fpos",
      "company": {
        "$ref": "base.main_company"
      },
      "values": {
        "name": "Foreign Trade",
        "auto_apply": true,
        "note": "<p>Export of services: not subject to sales tax.</p>"
      },
      "match": [
        [
          "id",
          "=",
          {
            "$ref": "account.1_template_generic_export_fiscal_position"
          }
        ]
      ],
      "depends_on": [
        "op_010_install_accountant"
      ],
      "rationale": "The chart's auto-applied Foreign Trade position already maps 15% to 0% for customers abroad; add the legal mention printed on their invoices.",
      "knowledge_refs": [
        "knowledge/20.0/accounting/fiscal_positions.md"
      ],
      "edition": "community"
    },
    {
      "id": "op_060_export_tax_label",
      "type": "upsert_record",
      "model": "account.tax",
      "key": "export_tax",
      "company": {
        "$ref": "base.main_company"
      },
      "values": {
        "invoice_label": "0% (export of services)",
        "fiscal_position_ids": {
          "$set": [
            {
              "$ref": "__ofa__.export_fpos"
            }
          ]
        },
        "original_tax_ids": {
          "$set": [
            {
              "$ref": "account.1_sale_tax_template"
            }
          ]
        }
      },
      "match": [
        [
          "id",
          "=",
          {
            "$ref": "account.1_sale_export_tax_template"
          }
        ]
      ],
      "depends_on": [
        "op_050_export_fpos"
      ],
      "rationale": "The 0% export tax replaces the domestic 15% under Foreign Trade and shows why on each invoice line.",
      "knowledge_refs": [
        "knowledge/20.0/accounting/fiscal_positions.md",
        "knowledge/20.0/accounting/taxes_and_tax_groups.md"
      ],
      "edition": "community"
    },
    {
      "id": "op_070_product_project",
      "type": "upsert_record",
      "model": "product.template",
      "key": "prod_project",
      "company": {
        "$ref": "base.main_company"
      },
      "values": {
        "name": "Fixed-price project",
        "type": "service",
        "sale_ok": true,
        "purchase_ok": false,
        "invoice_policy": "order",
        "taxes_id": {
          "$set": [
            {
              "$ref": "account.1_sale_tax_template"
            }
          ]
        }
      },
      "match": [
        [
          "name",
          "=",
          "Fixed-price project"
        ]
      ],
      "depends_on": [
        "op_010_install_accountant"
      ],
      "rationale": "Service product carrying the domestic 15% tax: Project work sold by sales order and invoiced 30% down payment then final invoice.",
      "knowledge_refs": [
        "knowledge/20.0/accounting/taxes_and_tax_groups.md"
      ],
      "edition": "community"
    },
    {
      "id": "op_080_product_retainer",
