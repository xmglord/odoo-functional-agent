      ],
      "rationale": "Service product carrying the domestic 15% tax: Software subscription bills.",
      "knowledge_refs": [
        "knowledge/20.0/accounting/taxes_and_tax_groups.md"
      ],
      "edition": "community"
    },
    {
      "id": "op_110_term_retainer",
      "type": "upsert_record",
      "model": "account.payment.term",
      "key": "term_retainer",
      "values": {
        "name": "Retainer: 15 days, 2% within 10 days",
        "early_discount": true,
        "discount_percentage": 2.0,
        "discount_days": 10,
        "early_pay_discount_computation": "included"
      },
      "match": [
        [
          "name",
          "=",
          "Retainer: 15 days, 2% within 10 days"
        ]
      ],
      "depends_on": [
        "op_010_install_accountant"
      ],
      "rationale": "Retainers are due in 15 days with a 2% early payment discount within 10 days; 'included' reduces the tax in proportion when the discount is taken.",
      "knowledge_refs": [
        "knowledge/20.0/accounting/payment_terms.md"
      ],
      "edition": "community"
    },
    {
      "id": "op_120_term_retainer_line",
      "type": "upsert_record",
      "model": "account.payment.term.line",
      "key": "term_retainer_line",
      "values": {
        "value": "percent",
        "value_amount": 100.0,
        "delay_type": "days_after",
        "nb_days": 15
      },
      "match": [
        [
          "payment_id",
          "=",
          {
            "$ref": "__ofa__.term_retainer"
          }
        ]
      ],
      "depends_on": [
        "op_110_term_retainer"
      ],
      "rationale": "The single 100% installment of the retainer term falls due 15 days after the invoice date.",
      "knowledge_refs": [
        "knowledge/20.0/accounting/payment_terms.md"
      ],
      "edition": "community"
    },
