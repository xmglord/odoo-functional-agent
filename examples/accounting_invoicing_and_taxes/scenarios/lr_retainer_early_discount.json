{
  "format": "ofa.scenario/1",
  "id": "lr_retainer_early_discount",
  "area": "accounting",
  "odoo_version": "20.0",
  "edition": "enterprise",
  "description": "Retainer due in 15 days; paid within 10 days with 2% off, the discount reduces the tax in proportion.",
  "requires": {
    "modules": [
      "accountant",
      "sale_management"
    ]
  },
  "company": {
    "$ref": "base.main_company"
  },
  "steps": [
    {
      "id": "s010_create",
      "action": "create",
      "model": "account.move",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "values": {
        "move_type": "out_invoice",
        "partner_id": 57,
        "invoice_date": "2026-10-01",
        "invoice_line_ids": {
          "$create": [
            {
              "product_id": 60,
              "quantity": 1,
              "price_unit": 1000,
              "analytic_distribution": {
                "28,24": 100
              }
            }
          ]
        }
      },
      "save_as": "inv"
    },
    {
      "id": "s010_post",
      "action": "call",
      "model": "account.move",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "target": {
        "$var": "inv"
      },
      "method": "action_post"
    },
    {
      "id": "s020",
      "action": "assert",
      "model": "account.move",
      "target": {
        "$var": "inv"
      },
      "expect": {
        "fields": {
          "invoice_payment_term_id": {
            "eq": {
              "$ref": "__ofa__.term_retainer"
            }
          },
          "invoice_date_due": {
            "eq": "2026-10-16"
          },
          "amount_total": {
            "eq": 1150
          }
        }
      }
    },
    {
      "id": "s030",
      "action": "search",
      "model": "account.move.line",
      "domain": [
        [
          "move_id",
          "in",
          [
            {
              "$var": "inv"
            }
          ]
        ],
        [
          "display_type",
          "=",
          "payment_term"
        ]
      ],
      "save_as": "recv",
      "expect": {
        "count": {
          "gte": 1
        }
      }
    },
    {
      "id": "s040_st",
      "action": "create",
      "model": "account.bank.statement.line",
      "as": {
        "$ref": "__ofa__.role_accountant"
      },
      "values": {
        "journal_id": 6,
        "date": "2026-10-08",
        "amount": 1127.0,
        "partner_id": 57,
        "payment_ref": "Cedar Lane retainer October"
      },
      "save_as": "st"
    },
    {
      "id": "s040_match",
      "action": "call",
      "model": "account.bank.statement.line",
      "as": {
        "$ref": "__ofa__.role_accountant"
      },
      "target": {
        "$var": "st"
      },
      "method": "set_line_bank_statement_line",
      "params": {
        "move_lines_ids": {
          "$var": "recv"
        }
      }
    },
    {
      "id": "s050",
      "action": "assert",
      "model": "account.move",
      "target": {
        "$var": "inv"
      },
      "expect": {
        "fields": {
          "payment_state": {
            "eq": "paid"
          },
          "amount_residual": {
            "eq": 0
          }
        }
      }
    },
    {
      "id": "s060",
      "action": "search",
      "model": "account.move.line",
      "domain": [
        [
          "statement_line_id",
          "=",
          {
            "$var": "st"
          }
        ],
        [
          "account_id",
          "=",
          39
        ],
        [
          "balance",
          "=",
          20.0
        ]
      ],
      "expect": {
        "count": 1
      }
    },
    {
      "id": "s070",
      "action": "search",
      "model": "account.move.line",
      "domain": [
        [
          "statement_line_id",
          "=",
          {
            "$var": "st"
          }
        ],
        [
          "tax_line_id",
          "=",
          {
            "$ref": "account.1_sale_tax_template"
          }
        ],
        [
          "balance",
          "=",
          3.0
        ]
      ],
      "expect": {
        "count": 1
      }
    }
  ],
  "evidence": [
    {
      "label": "retainer_invoice",
      "model": "account.move",
      "target": {
        "$var": "inv"
      },
      "fields": [
        "name",
        "partner_id",
        "state",
        "currency_id",
        "fiscal_position_id",
        "invoice_payment_term_id",
        "invoice_date",
        "invoice_date_due",
        "date",
        "amount_untaxed",
        "amount_tax",
        "amount_total",
        "amount_residual",
        "payment_state"
      ],
      "screenshot": true
    },
    {
      "label": "bank_line",
      "model": "account.bank.statement.line",
      "target": {
        "$var": "st"
      },
      "fields": [
        "date",
        "amount",
        "is_reconciled",
        "move_id"
      ],
      "screenshot": false
    }
  ]
}