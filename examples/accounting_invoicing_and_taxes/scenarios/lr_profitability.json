    {
      "id": "s030_post",
      "action": "call",
      "model": "account.move",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "target": {
        "$var": "bill2"
      },
      "method": "action_post"
    },
    {
      "id": "s040",
      "action": "assert",
      "model": "account.move",
      "target": [
        {
          "$var": "inv"
        },
        {
          "$var": "bill1"
        },
        {
          "$var": "bill2"
        }
      ],
      "expect": {
        "fields": {
          "state": {
            "eq": "posted"
          }
        }
      }
    },
    {
