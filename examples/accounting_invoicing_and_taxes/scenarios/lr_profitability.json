{
  "format": "ofa.scenario/1",
  "id": "lr_profitability",
  "area": "accounting",
  "odoo_version": "20.0",
  "edition": "enterprise",
  "description": "Clerk invoice and two bills on project Client Portal split by department: project margin and department amounts from analytic lines.",
  "requires": {
    "modules": [
      "accountant",
      "sale_management"
    ]
  },
  "company": {
    "$ref": "base.main_company"
  },
  "steps": [
    {
      "id": "s010_create",
      "action": "create",
      "model": "account.move",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "values": {
        "move_type": "out_invoice",
        "partner_id": 58,
        "invoice_date": "2026-10-18",
        "invoice_line_ids": {
          "$create": [
            {
              "product_id": 59,
              "quantity": 1,
              "price_unit": 3000,
              "analytic_distribution": {
                "27,24": 100
              }
            },
            {
              "product_id": 59,
              "quantity": 1,
              "price_unit": 2000,
              "analytic_distribution": {
                "27,25": 100
              }
            }
          ]
        }
      },
      "save_as": "inv"
    },
    {
      "id": "s010_post",
      "action": "call",
      "model": "account.move",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "target": {
        "$var": "inv"
      },
      "method": "action_post"
    },
    {
      "id": "s020_create",
      "action": "create",
      "model": "account.move",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "values": {
        "move_type": "in_invoice",
        "partner_id": 60,
        "invoice_date": "2026-10-18",
        "invoice_line_ids": {
          "$create": [
            {
              "product_id": 61,
              "quantity": 1,
              "price_unit": 1200,
              "analytic_distribution": {
                "27,25": 100
              }
            }
          ]
        }
      },
      "save_as": "bill1"
    },
    {
      "id": "s020_post",
      "action": "call",
      "model": "account.move",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "target": {
        "$var": "bill1"
      },
      "method": "action_post"
    },
    {
      "id": "s030_create",
      "action": "create",
      "model": "account.move",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "values": {
        "move_type": "in_invoice",
        "partner_id": 61,
