        "invoice_line_ids": {
          "$create": [
            {
              "product_id": 62,
              "quantity": 1,
              "price_unit": 300,
              "analytic_distribution": {
                "27,24": 100
              }
            }
          ]
        }
      },
      "save_as": "bill2"
