{
  "format": "ofa.scenario/1",
  "id": "lr_eur_exchange_difference",
  "area": "accounting",
  "odoo_version": "20.0",
  "edition": "enterprise",
  "description": "EUR invoice from a euro-pricelist order, paid into the EUR bank at a different rate: exchange gain booked, nothing left open.",
  "requires": {
    "modules": [
      "accountant",
      "sale_management"
    ]
  },
  "company": {
    "$ref": "base.main_company"
  },
  "steps": [
    {
      "id": "s005",
      "action": "create",
      "model": "res.currency.rate",
      "values": {
        "currency_id": 126,
        "name": "2026-08-31",
        "company_rate": 0.9,
        "company_id": 1
      }
    },
    {
      "id": "s006",
      "action": "create",
      "model": "res.currency.rate",
      "values": {
        "currency_id": 126,
        "name": "2026-09-19",
        "company_rate": 0.85,
        "company_id": 1
      }
    },
    {
      "id": "s010",
      "action": "create",
      "model": "sale.order",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "values": {
        "partner_id": 59,
        "order_line": {
          "$create": [
            {
              "product_id": 59,
              "product_uom_qty": 1,
              "price_unit": 1000,
              "analytic_distribution": {
                "26,25": 100
              }
            }
          ]
        }
      },
      "save_as": "so"
    },
    {
      "id": "s015",
      "action": "assert",
      "model": "sale.order",
      "target": {
        "$var": "so"
      },
      "expect": {
        "fields": {
          "currency_id": {
            "eq": 126
          },
          "pricelist_id": {
            "eq": {
              "$ref": "__ofa__.pricelist_eur"
            }
          }
        }
      }
    },
    {
      "id": "s020",
      "action": "call",
      "model": "sale.order",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "target": {
        "$var": "so"
      },
      "method": "action_confirm"
    },
    {
      "id": "s030",
      "action": "create",
      "model": "sale.advance.payment.inv",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "values": {
        "sale_order_ids": {
          "$set": [
            {
              "$var": "so"
            }
          ]
        },
        "advance_payment_method": "delivered"
      },
      "save_as": "wiz"
    },
    {
      "id": "s040",
      "action": "call",
      "model": "sale.advance.payment.inv",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "target": {
        "$var": "wiz"
      },
      "method": "create_invoices"
    },
    {
      "id": "s050",
      "action": "search",
      "model": "account.move",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "domain": [
        [
          "line_ids.sale_line_ids.order_id",
          "=",
          {
            "$var": "so"
          }
        ],
        [
          "move_type",
          "=",
          "out_invoice"
        ]
      ],
      "save_as": "inv",
      "expect": {
        "count": 1
      }
    },
    {
      "id": "s060",
      "action": "write",
      "model": "account.move",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "target": {
        "$var": "inv"
      },
      "values": {
        "invoice_date": "2026-09-01"
      }
    },
    {
      "id": "s070",
      "action": "call",
      "model": "account.move",
      "as": {
        "$ref": "__ofa__.role_clerk"
      },
      "target": {
        "$var": "inv"
      },
      "method": "action_post"
    },
    {
      "id": "s080",
      "action": "assert",
      "model": "account.move",
      "target": {
        "$var": "inv"
      },
      "expect": {
        "fields": {
          "currency_id": {
            "eq": 126
          },
          "amount_total": {
            "eq": 1000
          },
          "amount_tax": {
            "eq": 0
          }
        }
      }
    },
    {
      "id": "s090",
      "action": "search",
      "model": "account.move.line",
      "domain": [
        [
          "move_id",
          "in",
          {
            "$var": "inv"
          }
        ],
        [
          "display_type",
          "=",
          "payment_term"
        ]
      ],
      "save_as": "recv",
      "expect": {
        "count": {
          "gte": 1
        }
      }
    },
    {
      "id": "s100_st",
      "action": "create",
      "model": "account.bank.statement.line",
      "as": {
        "$ref": "__ofa__.role_accountant"
      },
      "values": {
        "journal_id": 37,
        "date": "2026-09-20",
        "amount": 1000.0,
        "partner_id": 59,
        "payment_ref": "Nordlicht payment EUR"
      },
      "save_as": "st"
    },
    {
      "id": "s100_match",
      "action": "call",
      "model": "account.bank.statement.line",
      "as": {
        "$ref": "__ofa__.role_accountant"
      },
      "target": {
        "$var": "st"
      },
      "method": "set_line_bank_statement_line",
      "params": {
        "move_lines_ids": {
          "$var": "recv"
        }
      }
    },
    {
      "id": "s110",
      "action": "assert",
      "model": "account.move",
      "target": {
        "$var": "inv"
      },
      "expect": {
        "fields": {
          "payment_state": {
            "eq": "paid"
          },
          "amount_residual": {
            "eq": 0
          }
        }
      }
    },
    {
      "id": "s120",
      "action": "assert",
      "model": "account.move.line",
      "target": {
        "$var": "recv"
      },
      "expect": {
        "fields": {
          "reconciled": {
            "eq": true
          },
          "amount_residual": {
            "eq": 0
          }
        }
      }
    },
    {
      "id": "s130",
      "action": "search",
      "model": "account.partial.reconcile",
      "domain": [
        [
          "debit_move_id",
          "in",
          {
            "$var": "recv"
          }
        ],
        [
          "exchange_move_id",
          "!=",
          false
        ]
      ],
      "save_as": "partial",
      "expect": {
        "count": 1
      }
    },
    {
      "id": "s140",
      "action": "search",
      "model": "account.move.line",
      "domain": [
        [
          "move_id.journal_id",
          "=",
          4
        ],
        [
          "account_id",
          "=",
          26
        ],
        [
          "partner_id",
          "=",
          59
        ]
      ],
      "expect": {
        "count": 1
      }
    }
  ],
  "evidence": [
    {
      "label": "eur_invoice",
      "model": "account.move",
      "target": {
        "$var": "inv"
      },
      "fields": [
        "name",
        "partner_id",
        "state",
        "currency_id",
        "fiscal_position_id",
        "invoice_payment_term_id",
        "invoice_date",
        "invoice_date_due",
        "date",
        "amount_untaxed",
        "amount_tax",
        "amount_total",
        "amount_residual",
        "payment_state",
        "invoice_currency_rate"
      ],
      "screenshot": true
    },
    {
      "label": "exchange_partial",
      "model": "account.partial.reconcile",
      "target": {
        "$var": "partial"
      },
      "fields": [
        "amount",
        "debit_amount_currency",
        "exchange_move_id"
      ],
      "screenshot": false
    }
  ]
}