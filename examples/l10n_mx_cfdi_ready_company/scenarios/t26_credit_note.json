{
 "format": "ofa.scenario/1",
 "id": "t26_credit_note",
 "area": "l10n_mx",
 "odoo_version": "20.0",
 "edition": "enterprise",
 "description": "Need 3: a return after invoicing is a credit note made with the reversal wizard from the stamped invoice; it is out_refund, linked to the original (reversed_entry_id) and its CFDI origin is 01|<UUID of the original>; it is stamped. Stamps with the Quadrum test PAC: needs network; demo CSD of company 4 expires 2027-05-18.",
 "requires": {
  "modules": [
   "l10n_mx_edi"
  ]
 },
 "company": {
  "$ref": "base.demo_company_mx"
 },
 "preconditions": [
  {
   "id": "p010",
   "action": "search",
   "model": "certificate.certificate",
   "domain": [
    [
     "company_id",
     "=",
     {
      "$ref": "base.demo_company_mx"
     }
    ],
    [
     "scope",
     "=",
     "cfdi_csd"
    ],
    [
     "is_valid",
     "=",
     true
    ]
   ],
   "expect": {
    "count": 1
   }
  }
 ],
 "steps": [
  {
   "id": "s005",
   "action": "create",
   "model": "product.product",
   "values": {
    "name": "OFA hex bolt M10 box",
    "type": "consu",
    "list_price": 1000.0,
    "company_id": {
     "$ref": "base.demo_company_mx"
    },
    "unspsc_code_id": {
     "$ref": "product_unspsc.unspsc_code_31161500"
    },
    "taxes_id": {
     "$set": [
      {
       "$ref": "account.4_tax12"
      }
     ]
    }
   },
   "save_as": "product"
  },
  {
   "id": "s010",
   "action": "create",
   "model": "account.move",
   "values": {
    "move_type": "out_invoice",
    "company_id": {
     "$ref": "base.demo_company_mx"
    },
    "journal_id": {
     "$ref": "account.4_sale"
    },
    "partner_id": {
     "$ref": "l10n_mx_edi.demo_partner_quadrum_1"
    },
    "invoice_line_ids": {
     "$create": [
      {
       "product_id": {
        "$var": "product"
       },
       "quantity": 1,
       "price_unit": 1000.0
      }
     ]
    },
    "l10n_mx_edi_payment_method_id": {
     "$ref": "l10n_mx_edi.payment_method_transferencia"
    },
    "invoice_payment_term_id": {
     "$ref": "account.account_payment_term_immediate"
    },
    "invoice_date": "2026-10-28"
   },
   "save_as": "inv"
  },
  {
   "id": "s020",
   "action": "call",
   "model": "account.move",
   "target": {
    "$var": "inv"
   },
   "method": "action_post"
  },
  {
   "id": "s030",
   "action": "call",
   "model": "account.move",
   "target": {
    "$var": "inv"
   },
   "method": "action_send_and_print",
   "wizards": {
    "account.move.send.wizard": "action_send_and_print"
   }
  },
  {
   "id": "s040",
   "action": "assert",
   "model": "account.move",
   "target": {
    "$var": "inv"
   },
   "expect": {
    "fields": {
     "l10n_mx_edi_cfdi_state": {
      "eq": "sent"
     }
    }
   }
  },
  {
   "id": "s050",
   "action": "create",
   "model": "account.move.reversal",
   "values": {
    "move_ids": {
     "$set": [
      {
       "$var": "inv"
      }
     ]
    },
    "reason": "OFA return of 1 box",
    "journal_id": {
     "$ref": "account.4_sale"
    }
   },
   "save_as": "wiz"
  },
  {
   "id": "s060",
   "action": "call",
   "model": "account.move.reversal",
   "target": {
    "$var": "wiz"
   },
   "method": "reverse_moves"
  },
  {
   "id": "s070",
   "action": "search",
   "model": "account.move",
   "domain": [
    [
     "reversed_entry_id",
     "=",
     {
      "$var": "inv"
     }
    ]
   ],
   "save_as": "refund",
   "expect": {
    "count": 1
   }
  },
  {
   "id": "s080",
   "action": "assert",
   "model": "account.move",
   "target": {
    "$var": "refund"
   },
   "expect": {
    "fields": {
     "move_type": {
      "eq": "out_refund"
     },
     "l10n_mx_edi_cfdi_origin": {
      "contains": "01|"
     },
     "amount_total": {
      "eq": 1160.0
     }
    }
   }
  },
  {
   "id": "s090",
   "action": "call",
   "model": "account.move",
   "target": {
    "$var": "refund"
   },
   "method": "action_post"
  },
  {
   "id": "s100",
   "action": "call",
   "model": "account.move",
   "target": {
    "$var": "refund"
   },
   "method": "action_send_and_print",
   "wizards": {
    "account.move.send.wizard": "action_send_and_print"
   }
  },
  {
   "id": "s110",
   "action": "assert",
   "model": "account.move",
   "target": {
    "$var": "refund"
   },
   "expect": {
    "fields": {
     "state": {
      "eq": "posted"
     },
     "l10n_mx_edi_cfdi_state": {
      "eq": "sent"
     },
     "l10n_mx_edi_cfdi_uuid": {
      "ne": false
     }
    }
   }
  }
 ],
 "evidence": [
  {
   "label": "original_invoice",
   "model": "account.move",
   "target": {
    "$var": "inv"
   },
   "fields": [
    "name",
    "state",
    "partner_id",
    "amount_untaxed",
    "amount_tax",
    "amount_total",
    "l10n_mx_edi_usage",
    "l10n_mx_edi_payment_policy",
    "l10n_mx_edi_payment_method_id",
    "l10n_mx_edi_cfdi_to_public",
    "l10n_mx_edi_cfdi_state",
    "l10n_mx_edi_cfdi_uuid",
    "l10n_mx_edi_cfdi_origin"
   ],
   "screenshot": false
  },
  {
   "label": "credit_note",
   "model": "account.move",
   "target": {
    "$var": "refund"
   },
   "fields": [
    "name",
    "state",
    "partner_id",
    "amount_untaxed",
    "amount_tax",
    "amount_total",
    "l10n_mx_edi_usage",
    "l10n_mx_edi_payment_policy",
    "l10n_mx_edi_payment_method_id",
    "l10n_mx_edi_cfdi_to_public",
    "l10n_mx_edi_cfdi_state",
    "l10n_mx_edi_cfdi_uuid",
    "l10n_mx_edi_cfdi_origin",
    "reversed_entry_id",
    "move_type"
   ],
   "screenshot": true
  }
 ]
}