{
  "format": "ofa.scenario/1",
  "id": "vantage_campaign_partial_milestones",
  "area": "sales_crm",
  "odoo_version": "20.0",
  "edition": "enterprise",
  "description": "A campaign billed in two 30% milestones and a final invoice: each milestone is a percentage down payment, the final regular invoice deducts both, and the order balance follows each step.",
  "company": {
    "$ref": "base.demo_company_mx"
  },
  "requires": {
    "modules": [
      "sale_management",
      "account"
    ]
  },
  "preconditions": [
    {
      "id": "p010",
      "action": "search",
      "model": "crm.team",
      "domain": [
        [
          "id",
          "=",
          {
            "$ref": "__ofa__.campaign_sales_team"
          }
        ]
      ],
      "expect": {
        "count": 1
      }
    }
  ],
  "steps": [
    {
      "id": "s010",
      "action": "create",
      "model": "res.partner",
      "values": {
        "name": "Lumen Partners (OFA test)",
        "is_company": true,
        "x_customer_type": "business_partner"
      },
      "save_as": "partner"
    },
    {
      "id": "s010_chk",
      "action": "assert",
      "model": "res.partner",
      "target": {
        "$var": "partner"
      },
      "expect": {
        "fields": {
          "x_customer_type": {
            "eq": "business_partner"
          }
        }
      }
    },
    {
      "id": "s020",
      "action": "create",
      "model": "sale.order",
      "values": {
        "partner_id": {
          "$var": "partner"
        },
        "company_id": {
          "$ref": "base.demo_company_mx"
        },
        "pricelist_id": {
          "$search": {
            "model": "product.pricelist",
            "domain": [
              [
                "company_id",
                "=",
                {
                  "$ref": "base.demo_company_mx"
                }
              ]
            ]
          }
        },
        "x_billing_method": "partial",
        "order_line": {
          "$create": [
            {
              "product_id": {
                "$search": {
                  "model": "product.product",
                  "domain": [
                    [
                      "product_tmpl_id",
                      "=",
                      {
                        "$ref": "__ofa__.prod_sponsored_wifi"
                      }
                    ]
                  ]
                }
              },
              "product_uom_qty": 1,
              "price_unit": 25000.0,
              "discount": 0.0,
              "x_start_date": "2027-03-01",
              "x_end_date": "2027-03-05",
              "product_no_variant_attribute_value_ids": {
                "$set": [
                  {
                    "$search": {
                      "model": "product.template.attribute.value",
                      "domain": [
                        [
                          "product_tmpl_id",
                          "=",
                          {
                            "$ref": "__ofa__.prod_sponsored_wifi"
                          }
                        ],
                        [
                          "product_attribute_value_id",
                          "=",
                          {
                            "$ref": "__ofa__.venue_north_expo"
                          }
                        ]
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        "client_order_ref": "PO-9902"
      },
      "save_as": "so"
    },
    {
      "id": "s030",
      "action": "call",
      "model": "sale.order",
      "target": {
        "$var": "so"
      },
      "method": "action_confirm"
    },
    {
      "id": "s040",
      "action": "create",
      "model": "sale.advance.payment.inv",
      "values": {
        "sale_order_ids": {
          "$set": [
            {
              "$var": "so"
            }
          ]
        },
        "advance_payment_method": "percentage",
        "amount": 30
      },
      "save_as": "wiz"
    },
    {
      "id": "s040_run",
      "action": "call",
      "model": "sale.advance.payment.inv",
      "target": {
        "$var": "wiz"
      },
      "method": "create_invoices"
    },
    {
      "id": "s050",
      "action": "search",
      "model": "account.move",
      "domain": [
        [
          "invoice_line_ids.sale_line_ids.order_id",
          "=",
          {
            "$var": "so"
          }
        ],
        [
          "move_type",
          "=",
          "out_invoice"
        ]
      ],
      "save_as": "inv_m1",
      "expect": {
        "count": 1
      }
    },
    {
      "id": "s060",
      "action": "call",
      "model": "account.move",
      "target": {
        "$var": "inv_m1"
      },
      "method": "action_post"
    },
    {
      "id": "s070",
      "action": "create",
      "model": "sale.advance.payment.inv",
      "values": {
        "sale_order_ids": {
          "$set": [
            {
              "$var": "so"
            }
          ]
        },
        "advance_payment_method": "percentage",
        "amount": 30
      },
      "save_as": "wiz2"
    },
    {
      "id": "s070_run",
      "action": "call",
      "model": "sale.advance.payment.inv",
      "target": {
        "$var": "wiz2"
      },
      "method": "create_invoices"
    },
    {
      "id": "s080",
      "action": "search",
      "model": "account.move",
      "domain": [
        [
          "invoice_line_ids.sale_line_ids.order_id",
          "=",
          {
            "$var": "so"
          }
        ],
        [
          "move_type",
          "=",
          "out_invoice"
        ]
      ],
      "save_as": "inv_m12",
      "expect": {
        "count": 2
      }
    },
    {
      "id": "s090",
      "action": "call",
      "model": "account.move",
      "target": {
        "$search": {
          "model": "account.move",
          "domain": [
            [
              "invoice_line_ids.sale_line_ids.order_id",
              "=",
              {
                "$var": "so"
              }
            ],
            [
              "move_type",
              "=",
              "out_invoice"
            ],
            [
              "id",
              "not in",
              {
                "$var": "inv_m1"
              }
            ]
          ]
        }
      },
      "method": "action_post"
    },
    {
      "id": "s100",
      "action": "assert",
      "model": "sale.order",
      "target": {
        "$var": "so"
      },
      "expect": {
        "fields": {
          "amount_invoiced": {
            "eq": 17400.0
          },
          "amount_unpaid": {
            "eq": 11600.0
          }
        }
      }
    },
    {
      "id": "s110",
      "action": "create",
      "model": "sale.advance.payment.inv",
      "values": {
        "sale_order_ids": {
          "$set": [
            {
              "$var": "so"
            }
          ]
        },
        "advance_payment_method": "delivered"
      },
      "save_as": "wiz3"
    },
    {
      "id": "s110_run",
      "action": "call",
      "model": "sale.advance.payment.inv",
      "target": {
        "$var": "wiz3"
      },
      "method": "create_invoices"
    },
    {
      "id": "s120",
      "action": "search",
      "model": "account.move",
      "domain": [
        [
          "invoice_line_ids.sale_line_ids.order_id",
          "=",
          {
            "$var": "so"
          }
        ],
        [
          "move_type",
          "=",
          "out_invoice"
        ],
        [
          "state",
          "=",
          "draft"
        ]
      ],
      "save_as": "inv_last",
      "expect": {
        "count": 1
      }
    },
    {
      "id": "s130",
      "action": "assert",
      "model": "account.move",
      "target": {
        "$var": "inv_last"
      },
      "expect": {
        "fields": {
          "amount_untaxed": {
            "eq": 10000.0
          },
          "ref": {
            "eq": "PO-9902"
          },
          "invoice_origin": {
            "contains": "CMP/"
          }
        }
      }
    },
    {
      "id": "s140",
      "action": "call",
      "model": "account.move",
      "target": {
        "$var": "inv_last"
      },
      "method": "action_post"
    },
    {
      "id": "s150",
      "action": "assert",
      "model": "sale.order",
      "target": {
        "$var": "so"
      },
      "expect": {
        "fields": {
          "amount_invoiced": {
            "eq": 29000.0
          },
          "amount_unpaid": {
            "eq": 0
          },
          "invoice_count": {
            "eq": 3
          }
        }
      }
    }
  ],
  "evidence": [
    {
      "label": "milestone_order",
      "model": "sale.order",
      "target": {
        "$var": "so"
      },
      "fields": [
        "name",
        "x_billing_method",
        "amount_total",
        "amount_invoiced",
        "amount_to_invoice",
        "amount_unpaid",
        "invoice_count"
      ],
      "screenshot": true
    }
  ]
}
