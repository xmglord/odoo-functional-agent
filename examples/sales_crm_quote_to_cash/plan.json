{
  "format": "ofa.plan/1",
  "title": "Vantage Venue Media: campaign sales cycle from opportunity to payment",
  "odoo_version": "20.0",
  "edition": "enterprise",
  "areas": [
    "sales_crm",
    "accounting",
    "l10n_mx"
  ],
  "operations": [
    {
      "id": "op_010_install_apps",
      "type": "install_modules",
      "modules": [
        "sale_management",
        "crm",
        "sale_crm",
        "account_followup"
      ],
      "rationale": "CRM, Sales, the CRM-Sales link and customer follow-up are the apps the cycle runs on.",
      "knowledge_refs": [
        "knowledge/20.0/sales_crm/leads_opportunities_pipeline.md",
        "knowledge/20.0/accounting/payment_terms.md"
      ],
      "edition": "enterprise",
      "depends_on": []
    },
    {
      "id": "op_020_sales_settings",
      "type": "set_settings",
      "company": {
        "$ref": "base.demo_company_mx"
      },
      "depends_on": [
        "op_010_install_apps"
      ],
      "values": {
        "group_discount_per_so_line": true,
        "group_product_variant": true,
        "downpayment_account_id": {
          "$ref": "account.4_cuenta206_01"
        }
      },
      "rationale": "Per-line discounts, venue attribute on products, and down payments booked as customer advances.",
      "knowledge_refs": [
        "knowledge/20.0/sales_crm/discounts.md",
        "knowledge/20.0/sales_crm/down_payments.md"
      ],
      "edition": "community"
    },
    {
      "id": "op_030_campaign_sequence",
      "type": "upsert_record",
      "model": "ir.sequence",
      "key": "campaign_code_sequence",
      "company": {
        "$ref": "base.demo_company_mx"
      },
      "depends_on": [
        "op_010_install_apps"
      ],
      "values": {
        "name": "Campaign code (Vantage)",
        "code": "sale.order",
        "prefix": "CMP/%(year)s/",
        "padding": 4,
        "company_id": {
          "$ref": "base.demo_company_mx"
        },
        "implementation": "standard",
        "use_date_range": false
      },
      "match": [
        [
          "code",
          "=",
          "sale.order"
        ],
        [
          "company_id",
          "=",
          {
            "$ref": "base.demo_company_mx"
          }
        ]
      ],
      "rationale": "Each quotation gets a unique CMP/<year>/nnnn campaign code from a Mexican-company sale.order sequence.",
      "edition": "community",
      "knowledge_refs": []
    },
    {
      "id": "op_040_campaign_team",
      "type": "upsert_record",
      "model": "crm.team",
      "key": "campaign_sales_team",
      "company": {
        "$ref": "base.demo_company_mx"
      },
      "depends_on": [
        "op_010_install_apps"
      ],
      "values": {
        "name": "Campaign Sales",
        "company_id": {
          "$ref": "base.demo_company_mx"
        },
        "use_leads": false,
        "use_opportunities": true,
        "lead_properties_definition": [
          {
            "name": "media",
            "tags": [
              [
                "digital_screen",
                "Digital screen",
                1
              ],
              [
                "totem",
                "Totem",
                2
              ],
              [
                "stand",
                "Stand",
                3
              ],
              [
                "wifi",
                "Sponsored Wi-Fi",
                4
              ],
              [
                "printed",
                "Printed media",
                5
              ]
            ],
            "type": "tags",
            "string": "Media"
          },
          {
            "name": "venues",
            "type": "char",
            "string": "Venues"
          },
          {
            "name": "campaign_start",
            "type": "date",
            "string": "Campaign start"
          },
          {
            "name": "campaign_end",
            "type": "date",
            "string": "Campaign end"
          }
        ]
      },
      "match": [
        [
          "name",
          "=",
          "Campaign Sales"
        ]
      ],
      "rationale": "A sales team for campaigns whose lead properties hold the brief: media, venues, start and end dates.",
      "knowledge_refs": [
        "knowledge/20.0/sales_crm/sales_teams.md",
        "knowledge/20.0/sales_crm/leads_opportunities_pipeline.md"
      ],
      "edition": "community"
    },
    {
      "id": "op_050_stage_prospect",
      "type": "upsert_record",
      "model": "crm.stage",
      "key": "stage_prospect",
      "depends_on": [
        "op_010_install_apps"
      ],
      "values": {
        "name": "Prospect",
        "sequence": 1,
        "is_won": false
      },
      "match": [
        [
          "id",
          "=",
          {
            "$ref": "crm.stage_lead1"
          }
        ]
      ],
      "rationale": "Pipeline stage 'Prospect' (sequence 1).",
      "knowledge_refs": [
        "knowledge/20.0/sales_crm/leads_opportunities_pipeline.md"
      ],
      "edition": "community"
    },
    {
