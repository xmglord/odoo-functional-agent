      "values": {
        "name": "sale.order.form.vantage.campaign",
        "model": "sale.order",
        "type": "form",
        "mode": "extension",
        "priority": 99,
        "inherit_id": {
          "$ref": "sale.view_order_form"
        },
        "arch": "<data><xpath expr=\"//field[@name='payment_term_id']\" position=\"after\"><field name=\"x_billing_method\" readonly=\"state == 'cancel'\"/><field name=\"amount_invoiced\" invisible=\"state != 'sale'\"/><field name=\"amount_unpaid\" invisible=\"state != 'sale'\"/></xpath><xpath expr=\"//field[@name='order_line']/list/field[@name='discount']\" position=\"before\"><field name=\"x_start_date\" optional=\"show\"/><field name=\"x_end_date\" optional=\"show\"/></xpath></data>"
      },
      "match": [
        [
          "name",
          "=",
          "sale.order.form.vantage.campaign"
        ]
      ],
      "rationale": "Show billing method, invoiced and pending amounts on the order, and start/end dates on its lines.",
