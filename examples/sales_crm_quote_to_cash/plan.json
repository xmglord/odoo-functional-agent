      "knowledge_refs": [
        "knowledge/20.0/sales_crm/leads_opportunities_pipeline.md"
      ],
      "edition": "community"
    },
    {
      "id": "op_080_stage_negotiation",
      "type": "upsert_record",
      "model": "crm.stage",
      "key": "stage_negotiation",
      "depends_on": [
        "op_010_install_apps"
      ],
      "values": {
        "name": "Negotiation",
        "sequence": 4,
        "is_won": false
