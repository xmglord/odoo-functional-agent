#!/usr/bin/env python3
"""Launcher for the ofa CLI: puts <root>/src on sys.path and runs ofa.cli.main()."""
import os
import sys

if sys.version_info < (3, 11):
    sys.stderr.write("ofa: 2: Python 3.11 or newer is required (found %d.%d)\n" % sys.version_info[:2])
    sys.exit(2)

_root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_root, "src"))

from ofa.cli import main  # noqa: E402

sys.exit(main())
